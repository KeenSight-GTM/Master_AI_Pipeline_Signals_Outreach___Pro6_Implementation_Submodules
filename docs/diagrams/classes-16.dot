digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"SendGateDecision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SendGateDecision</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">gate_id</TD></TR><TR><TD ALIGN="LEFT">intent_ref</TD></TR><TR><TD ALIGN="LEFT">message_ref</TD></TR><TR><TD ALIGN="LEFT">review_ref</TD></TR><TR><TD ALIGN="LEFT">campaign_approval_ref</TD></TR><TR><TD ALIGN="LEFT">readiness_ref</TD></TR><TR><TD ALIGN="LEFT">recipient_ref</TD></TR><TR><TD ALIGN="LEFT">current_restriction_vector</TD></TR><TR><TD ALIGN="LEFT">current_contact_vector</TD></TR><TR><TD ALIGN="LEFT">evaluated_at</TD></TR><TR><TD ALIGN="LEFT">valid_until</TD></TR><TR><TD ALIGN="LEFT">decision</TD></TR><TR><TD ALIGN="LEFT">reasons</TD></TR></TABLE>>];
"SenderCapabilitySnapshot" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SenderCapabilitySnapshot</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">snapshot_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">sender_account_ref</TD></TR><TR><TD ALIGN="LEFT">provider</TD></TR><TR><TD ALIGN="LEFT">channel</TD></TR><TR><TD ALIGN="LEFT">verified_capabilities</TD></TR><TR><TD ALIGN="LEFT">live_state</TD></TR><TR><TD ALIGN="LEFT">checked_at</TD></TR><TR><TD ALIGN="LEFT">configuration_digest</TD></TR></TABLE>>];
"DeliveryAttempt" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>DeliveryAttempt</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">attempt_id</TD></TR><TR><TD ALIGN="LEFT">intent_ref</TD></TR><TR><TD ALIGN="LEFT">gate_ref</TD></TR><TR><TD ALIGN="LEFT">request_digest</TD></TR><TR><TD ALIGN="LEFT">started_at</TD></TR><TR><TD ALIGN="LEFT">finished_at</TD></TR><TR><TD ALIGN="LEFT">transport_status</TD></TR><TR><TD ALIGN="LEFT">acceptance_status</TD></TR><TR><TD ALIGN="LEFT">external_message_ref</TD></TR><TR><TD ALIGN="LEFT">error_ref</TD></TR></TABLE>>];
"Conversation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>Conversation</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">conversation_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">account_ref</TD></TR><TR><TD ALIGN="LEFT">contact_refs</TD></TR><TR><TD ALIGN="LEFT">provider_account_ref</TD></TR><TR><TD ALIGN="LEFT">external_thread_ref</TD></TR><TR><TD ALIGN="LEFT">event_refs</TD></TR><TR><TD ALIGN="LEFT">enrollment_links</TD></TR><TR><TD ALIGN="LEFT">current_owner</TD></TR><TR><TD ALIGN="LEFT">state</TD></TR></TABLE>>];
"ReplyAssessment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ReplyAssessment</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">assessment_id</TD></TR><TR><TD ALIGN="LEFT">inbound_event_ref</TD></TR><TR><TD ALIGN="LEFT">classification_kind</TD></TR><TR><TD ALIGN="LEFT">literal_support_refs</TD></TR><TR><TD ALIGN="LEFT">producer_execution_ref</TD></TR><TR><TD ALIGN="LEFT">confidence_metadata</TD></TR><TR><TD ALIGN="LEFT">human_review_state</TD></TR><TR><TD ALIGN="LEFT">recommended_action</TD></TR></TABLE>>];
"EnrollmentControl" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>EnrollmentControl</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">control_id</TD></TR><TR><TD ALIGN="LEFT">target_enrollment_refs</TD></TR><TR><TD ALIGN="LEFT">cause_event_ref</TD></TR><TR><TD ALIGN="LEFT">desired_transition</TD></TR><TR><TD ALIGN="LEFT">scope</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT">expected_state_refs</TD></TR></TABLE>>];
"SendGateDecision" -> "SenderCapabilitySnapshot" [style=invis];
"SenderCapabilitySnapshot" -> "DeliveryAttempt" [style=invis];
"DeliveryAttempt" -> "Conversation" [style=invis];
"Conversation" -> "ReplyAssessment" [style=invis];
"ReplyAssessment" -> "EnrollmentControl" [style=invis];
}