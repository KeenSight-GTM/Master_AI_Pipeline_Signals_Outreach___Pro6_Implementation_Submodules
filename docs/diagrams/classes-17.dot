digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"FollowUpTask" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>FollowUpTask</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">task_id</TD></TR><TR><TD ALIGN="LEFT">conversation_ref</TD></TR><TR><TD ALIGN="LEFT">assigned_owner</TD></TR><TR><TD ALIGN="LEFT">task_kind</TD></TR><TR><TD ALIGN="LEFT">due_at</TD></TR><TR><TD ALIGN="LEFT">source_event_ref</TD></TR><TR><TD ALIGN="LEFT">state</TD></TR><TR><TD ALIGN="LEFT">authorization_requirements</TD></TR></TABLE>>];
"SalesHandoff" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SalesHandoff</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">handoff_id</TD></TR><TR><TD ALIGN="LEFT">account_ref</TD></TR><TR><TD ALIGN="LEFT">contact_ref</TD></TR><TR><TD ALIGN="LEFT">conversation_ref</TD></TR><TR><TD ALIGN="LEFT">exposure_refs</TD></TR><TR><TD ALIGN="LEFT">qualification_notes_refs</TD></TR><TR><TD ALIGN="LEFT">intended_owner</TD></TR><TR><TD ALIGN="LEFT">meeting_or_next_action</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE>>];
"CRMMapping" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CRMMapping</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">mapping_id</TD></TR><TR><TD ALIGN="LEFT">provider</TD></TR><TR><TD ALIGN="LEFT">schema_version</TD></TR><TR><TD ALIGN="LEFT">field_ownership</TD></TR><TR><TD ALIGN="LEFT">inbound_outbound_transforms</TD></TR><TR><TD ALIGN="LEFT">idempotency_policy</TD></TR><TR><TD ALIGN="LEFT">suppression_rules</TD></TR><TR><TD ALIGN="LEFT">loop_prevention</TD></TR></TABLE>>];
"CRMAccountView" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CRMAccountView</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">view_id</TD></TR><TR><TD ALIGN="LEFT">account_ref</TD></TR><TR><TD ALIGN="LEFT">external_record_links</TD></TR><TR><TD ALIGN="LEFT">owner</TD></TR><TR><TD ALIGN="LEFT">lifecycle_stage</TD></TR><TR><TD ALIGN="LEFT">customer_or_open_deal_state</TD></TR><TR><TD ALIGN="LEFT">restriction_observations</TD></TR><TR><TD ALIGN="LEFT">provider_version</TD></TR><TR><TD ALIGN="LEFT">fetched_at</TD></TR></TABLE>>];
"CRMSyncIntent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CRMSyncIntent</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">sync_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">mapping_ref</TD></TR><TR><TD ALIGN="LEFT">entity_link</TD></TR><TR><TD ALIGN="LEFT">desired_fields</TD></TR><TR><TD ALIGN="LEFT">source_record_refs</TD></TR><TR><TD ALIGN="LEFT">expected_remote_version</TD></TR><TR><TD ALIGN="LEFT">idempotency_key</TD></TR></TABLE>>];
"CRMSyncReceipt" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CRMSyncReceipt</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">receipt_id</TD></TR><TR><TD ALIGN="LEFT">sync_intent_ref</TD></TR><TR><TD ALIGN="LEFT">external_record_ref</TD></TR><TR><TD ALIGN="LEFT">payload_hash</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">provider_version</TD></TR><TR><TD ALIGN="LEFT">confirmed_at</TD></TR><TR><TD ALIGN="LEFT">reconciliation_ref</TD></TR></TABLE>>];
"FollowUpTask" -> "SalesHandoff" [style=invis];
"SalesHandoff" -> "CRMMapping" [style=invis];
"CRMMapping" -> "CRMAccountView" [style=invis];
"CRMAccountView" -> "CRMSyncIntent" [style=invis];
"CRMSyncIntent" -> "CRMSyncReceipt" [style=invis];
}