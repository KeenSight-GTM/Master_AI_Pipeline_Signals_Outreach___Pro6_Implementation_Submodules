digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"AcquisitionAttempt" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>AcquisitionAttempt</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">adapter_version</TD></TR><TR><TD ALIGN="LEFT">artifact_ids</TD></TR><TR><TD ALIGN="LEFT">attempt_id</TD></TR><TR><TD ALIGN="LEFT">body_limit_bytes</TD></TR><TR><TD ALIGN="LEFT">cost_minor</TD></TR><TR><TD ALIGN="LEFT">cost_status</TD></TR><TR><TD ALIGN="LEFT">currency</TD></TR><TR><TD ALIGN="LEFT">execution_mode</TD></TR><TR><TD ALIGN="LEFT">finished_at</TD></TR><TR><TD ALIGN="LEFT">intake_id</TD></TR><TR><TD ALIGN="LEFT">max_requests</TD></TR><TR><TD ALIGN="LEFT">operation_key</TD></TR><TR><TD ALIGN="LEFT">pagination</TD></TR><TR><TD ALIGN="LEFT">request_hash</TD></TR><TR><TD ALIGN="LEFT">requests_made</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">source_id</TD></TR><TR><TD ALIGN="LEFT">source_version</TD></TR><TR><TD ALIGN="LEFT">started_at</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">target</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">terminal_reason</TD></TR><TR><TD ALIGN="LEFT">timeout_seconds</TD></TR><TR><TD ALIGN="LEFT">truncated</TD></TR></TABLE>>];
"ActorGrant" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ActorGrant</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">active</TD></TR><TR><TD ALIGN="LEFT">actor_id</TD></TR><TR><TD ALIGN="LEFT">fixture_only</TD></TR><TR><TD ALIGN="LEFT">permissions</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"Artifact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>Artifact</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">artifact_id</TD></TR><TR><TD ALIGN="LEFT">byte_count</TD></TR><TR><TD ALIGN="LEFT">captured_at</TD></TR><TR><TD ALIGN="LEFT">classification</TD></TR><TR><TD ALIGN="LEFT">content_hash</TD></TR><TR><TD ALIGN="LEFT">content_ref</TD></TR><TR><TD ALIGN="LEFT">independence_group</TD></TR><TR><TD ALIGN="LEFT">media_type</TD></TR><TR><TD ALIGN="LEFT">origin_namespace</TD></TR><TR><TD ALIGN="LEFT">origin_record_id</TD></TR><TR><TD ALIGN="LEFT">origin_revision</TD></TR><TR><TD ALIGN="LEFT">parent_artifact_id</TD></TR><TR><TD ALIGN="LEFT">published_at</TD></TR><TR><TD ALIGN="LEFT">resource_uri</TD></TR><TR><TD ALIGN="LEFT">retained_until</TD></TR><TR><TD ALIGN="LEFT">retention_state</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">source_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">truncated</TD></TR></TABLE>>];
"AttributedStatementValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>AttributedStatementValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">modality</TD></TR><TR><TD ALIGN="LEFT">statement_id</TD></TR><TR><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">topic_id</TD></TR></TABLE>>];
"BatchRun" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>BatchRun</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">approval_policy_version</TD></TR><TR><TD ALIGN="LEFT">as_of</TD></TR><TR><TD ALIGN="LEFT">binding_ids</TD></TR><TR><TD ALIGN="LEFT">code_release</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT">imported_execution_ids</TD></TR><TR><TD ALIGN="LEFT">input_artifact_ids</TD></TR><TR><TD ALIGN="LEFT">input_fact_ids</TD></TR><TR><TD ALIGN="LEFT">intake_id</TD></TR><TR><TD ALIGN="LEFT">knowledge_cutoff</TD></TR><TR><TD ALIGN="LEFT">mode</TD></TR><TR><TD ALIGN="LEFT">produced_artifact_ids</TD></TR><TR><TD ALIGN="LEFT">produced_fact_ids</TD></TR><TR><TD ALIGN="LEFT">profile_id</TD></TR><TR><TD ALIGN="LEFT">registry_release</TD></TR><TR><TD ALIGN="LEFT">resolution_ids</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">sample_ids</TD></TR><TR><TD ALIGN="LEFT">sealed_at</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">target_results</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"CalibrationRecord" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CalibrationRecord</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">calibration_id</TD></TR><TR><TD ALIGN="LEFT">evaluation_dataset_id</TD></TR><TR><TD ALIGN="LEFT">false_positives</TD></TR><TR><TD ALIGN="LEFT">fixture_only</TD></TR><TR><TD ALIGN="LEFT">measured_precision</TD></TR><TR><TD ALIGN="LEFT">report_hash</TD></TR><TR><TD ALIGN="LEFT">review_ref</TD></TR><TR><TD ALIGN="LEFT">target_id</TD></TR><TR><TD ALIGN="LEFT">target_version</TD></TR><TR><TD ALIGN="LEFT">true_positives</TD></TR></TABLE>>];
"AcquisitionAttempt" -> "ActorGrant" [style=invis];
"ActorGrant" -> "Artifact" [style=invis];
"Artifact" -> "AttributedStatementValue" [style=invis];
"AttributedStatementValue" -> "BatchRun" [style=invis];
"BatchRun" -> "CalibrationRecord" [style=invis];
}