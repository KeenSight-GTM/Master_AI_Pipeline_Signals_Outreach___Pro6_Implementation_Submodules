digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"SignalDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SignalDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">context_allowed</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">function_id</TD></TR><TR><TD ALIGN="LEFT">required_facts</TD></TR><TR><TD ALIGN="LEFT">signal_type_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR></TABLE>>];
"SignalEvaluation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SignalEvaluation</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">context_ids</TD></TR><TR><TD ALIGN="LEFT">evaluated_at</TD></TR><TR><TD ALIGN="LEFT">input_fact_ids</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">signal_id</TD></TR><TR><TD ALIGN="LEFT">signal_type_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"SourceDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SourceDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">acquisition_method</TD></TR><TR><TD ALIGN="LEFT">adapter_status</TD></TR><TR><TD ALIGN="LEFT">allowed_natures</TD></TR><TR><TD ALIGN="LEFT">authority</TD></TR><TR><TD ALIGN="LEFT">emits</TD></TR><TR><TD ALIGN="LEFT">fixture_only</TD></TR><TR><TD ALIGN="LEFT">freshness_seconds</TD></TR><TR><TD ALIGN="LEFT">policy_id</TD></TR><TR><TD ALIGN="LEFT">provider</TD></TR><TR><TD ALIGN="LEFT">source_id</TD></TR><TR><TD ALIGN="LEFT">upstream_namespace</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR></TABLE>>];
"Subject" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>Subject</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">display_name</TD></TR><TR><TD ALIGN="LEFT">external_ids</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"SubjectBinding" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SubjectBinding</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">artifact_ids</TD></TR><TR><TD ALIGN="LEFT">binding_id</TD></TR><TR><TD ALIGN="LEFT">decided_at</TD></TR><TR><TD ALIGN="LEFT">evidence_locator_ids</TD></TR><TR><TD ALIGN="LEFT">method</TD></TR><TR><TD ALIGN="LEFT">role</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"SurfaceObservationValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SurfaceObservationValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">observed_value</TD></TR><TR><TD ALIGN="LEFT">surface_key</TD></TR></TABLE>>];
"SignalDefinition" -> "SignalEvaluation" [style=invis];
"SignalEvaluation" -> "SourceDefinition" [style=invis];
"SourceDefinition" -> "Subject" [style=invis];
"Subject" -> "SubjectBinding" [style=invis];
"SubjectBinding" -> "SurfaceObservationValue" [style=invis];
}