digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"JobPostingValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>JobPostingValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">department</TD></TR><TR><TD ALIGN="LEFT">employment_type</TD></TR><TR><TD ALIGN="LEFT">namespace</TD></TR><TR><TD ALIGN="LEFT">posting_id</TD></TR><TR><TD ALIGN="LEFT">published_at</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">url</TD></TR></TABLE>>];
"LookalikeMatch" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>LookalikeMatch</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">comparison_subject_id</TD></TR><TR><TD ALIGN="LEFT">corpus_release</TD></TR><TR><TD ALIGN="LEFT">differences</TD></TR><TR><TD ALIGN="LEFT">implementation_status</TD></TR><TR><TD ALIGN="LEFT">index_version</TD></TR><TR><TD ALIGN="LEFT">input_fact_ids</TD></TR><TR><TD ALIGN="LEFT">match_id</TD></TR><TR><TD ALIGN="LEFT">missing_features</TD></TR><TR><TD ALIGN="LEFT">outcome_transfer_allowed</TD></TR><TR><TD ALIGN="LEFT">representation_version</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">similarity_score</TD></TR><TR><TD ALIGN="LEFT">target_subject_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">use</TD></TR></TABLE>>];
"MeasurementValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>MeasurementValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">denominator</TD></TR><TR><TD ALIGN="LEFT">dimensions</TD></TR><TR><TD ALIGN="LEFT">method_version</TD></TR><TR><TD ALIGN="LEFT">metric_id</TD></TR><TR><TD ALIGN="LEFT">numerator</TD></TR><TR><TD ALIGN="LEFT">reporting_timezone</TD></TR><TR><TD ALIGN="LEFT">sample_size</TD></TR><TR><TD ALIGN="LEFT">uncertainty</TD></TR><TR><TD ALIGN="LEFT">unit</TD></TR><TR><TD ALIGN="LEFT">value</TD></TR></TABLE>>];
"MetricDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>MetricDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">aggregation</TD></TR><TR><TD ALIGN="LEFT">allowed_natures</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">dimensions_schema</TD></TR><TR><TD ALIGN="LEFT">metric_id</TD></TR><TR><TD ALIGN="LEFT">requires_denominator</TD></TR><TR><TD ALIGN="LEFT">section_ids</TD></TR><TR><TD ALIGN="LEFT">subject_kinds</TD></TR><TR><TD ALIGN="LEFT">unit</TD></TR><TR><TD ALIGN="LEFT">value_schema</TD></TR></TABLE>>];
"ModelCall" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ModelCall</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">call_id</TD></TR><TR><TD ALIGN="LEFT">input_artifact_ids</TD></TR><TR><TD ALIGN="LEFT">max_repair_attempts</TD></TR><TR><TD ALIGN="LEFT">model</TD></TR><TR><TD ALIGN="LEFT">output_schema_id</TD></TR><TR><TD ALIGN="LEFT">policy_ids</TD></TR><TR><TD ALIGN="LEFT">prompt_hash</TD></TR><TR><TD ALIGN="LEFT">provider</TD></TR><TR><TD ALIGN="LEFT">request_artifact_id</TD></TR><TR><TD ALIGN="LEFT">response_artifact_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">task_version</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">terminal_reason</TD></TR></TABLE>>];
"ObjectReferenceRule" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ObjectReferenceRule</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">container</TD></TR><TR><TD ALIGN="LEFT">path</TD></TR><TR><TD ALIGN="LEFT">subject_kinds</TD></TR><TR><TD ALIGN="LEFT">target_type</TD></TR></TABLE>>];
"JobPostingValue" -> "LookalikeMatch" [style=invis];
"LookalikeMatch" -> "MeasurementValue" [style=invis];
"MeasurementValue" -> "MetricDefinition" [style=invis];
"MetricDefinition" -> "ModelCall" [style=invis];
"ModelCall" -> "ObjectReferenceRule" [style=invis];
}