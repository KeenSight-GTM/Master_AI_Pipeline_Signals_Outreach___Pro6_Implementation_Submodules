digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"ConfidenceAssessment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ConfidenceAssessment</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">calibration_id</TD></TR><TR><TD ALIGN="LEFT">meaning</TD></TR><TR><TD ALIGN="LEFT">value</TD></TR></TABLE>>];
"ContextAssessment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ContextAssessment</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">account_subject_id</TD></TR><TR><TD ALIGN="LEFT">company_claim_allowed</TD></TR><TR><TD ALIGN="LEFT">context_fact_ids</TD></TR><TR><TD ALIGN="LEFT">context_id</TD></TR><TR><TD ALIGN="LEFT">context_subject_id</TD></TR><TR><TD ALIGN="LEFT">join_rule_id</TD></TR><TR><TD ALIGN="LEFT">link_fact_id</TD></TR><TR><TD ALIGN="LEFT">purpose</TD></TR><TR><TD ALIGN="LEFT">relationship_strength</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"ContextJoinRule" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ContextJoinRule</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">company_claim_allowed</TD></TR><TR><TD ALIGN="LEFT">context_predicate</TD></TR><TR><TD ALIGN="LEFT">join_rule_id</TD></TR><TR><TD ALIGN="LEFT">link_kind</TD></TR><TR><TD ALIGN="LEFT">link_object_path</TD></TR><TR><TD ALIGN="LEFT">link_predicate</TD></TR><TR><TD ALIGN="LEFT">maximum_hops</TD></TR><TR><TD ALIGN="LEFT">purpose</TD></TR><TR><TD ALIGN="LEFT">target_kinds</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR></TABLE>>];
"CoverageCheck" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CoverageCheck</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">artifact_id</TD></TR><TR><TD ALIGN="LEFT">resource</TD></TR><TR><TD ALIGN="LEFT">result</TD></TR></TABLE>>];
"CoverageFamilyPlan" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CoverageFamilyPlan</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">contract_status</TD></TR><TR><TD ALIGN="LEFT">live_adapter_status</TD></TR><TR><TD ALIGN="LEFT">metric_ids</TD></TR><TR><TD ALIGN="LEFT">predicate_ids</TD></TR><TR><TD ALIGN="LEFT">section</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR></TABLE>>];
"CoverageRecord" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CoverageRecord</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">attempt_ids</TD></TR><TR><TD ALIGN="LEFT">checked</TD></TR><TR><TD ALIGN="LEFT">checked_at</TD></TR><TR><TD ALIGN="LEFT">coverage_id</TD></TR><TR><TD ALIGN="LEFT">detector_execution_id</TD></TR><TR><TD ALIGN="LEFT">detector_release</TD></TR><TR><TD ALIGN="LEFT">planned_resources</TD></TR><TR><TD ALIGN="LEFT">predicate_ids</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">scope_limitations</TD></TR><TR><TD ALIGN="LEFT">source_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">target</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"ConfidenceAssessment" -> "ContextAssessment" [style=invis];
"ContextAssessment" -> "ContextJoinRule" [style=invis];
"ContextJoinRule" -> "CoverageCheck" [style=invis];
"CoverageCheck" -> "CoverageFamilyPlan" [style=invis];
"CoverageFamilyPlan" -> "CoverageRecord" [style=invis];
}