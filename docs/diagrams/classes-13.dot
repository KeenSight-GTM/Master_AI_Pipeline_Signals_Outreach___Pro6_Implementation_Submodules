digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"TimeWindow" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>TimeWindow</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">end</TD></TR><TR><TD ALIGN="LEFT">start</TD></TR></TABLE>>];
"UseGateDecision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>UseGateDecision</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">actor_id</TD></TR><TR><TD ALIGN="LEFT">decision</TD></TR><TR><TD ALIGN="LEFT">destination_id</TD></TR><TR><TD ALIGN="LEFT">evaluated_at</TD></TR><TR><TD ALIGN="LEFT">gate_id</TD></TR><TR><TD ALIGN="LEFT">package</TD></TR><TR><TD ALIGN="LEFT">purpose</TD></TR><TR><TD ALIGN="LEFT">reasons</TD></TR><TR><TD ALIGN="LEFT">recipient_key</TD></TR><TR><TD ALIGN="LEFT">review_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">valid_until</TD></TR><TR><TD ALIGN="LEFT">version_vector</TD></TR></TABLE>>];
"UseRestriction" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>UseRestriction</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">actor_id</TD></TR><TR><TD ALIGN="LEFT">effective_at</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">recipient_key</TD></TR><TR><TD ALIGN="LEFT">released_at</TD></TR><TR><TD ALIGN="LEFT">released_by</TD></TR><TR><TD ALIGN="LEFT">restriction_id</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"ProgramDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ProgramDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">program_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">revision</TD></TR><TR><TD ALIGN="LEFT">objectives</TD></TR><TR><TD ALIGN="LEFT">audience_ref</TD></TR><TR><TD ALIGN="LEFT">offer_refs</TD></TR><TR><TD ALIGN="LEFT">capability_profile_ref</TD></TR><TR><TD ALIGN="LEFT">acquisition_limits</TD></TR><TR><TD ALIGN="LEFT">outreach_policy_ref</TD></TR><TR><TD ALIGN="LEFT">owner</TD></TR><TR><TD ALIGN="LEFT">approval_state</TD></TR></TABLE>>];
"AudienceDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>AudienceDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">audience_id</TD></TR><TR><TD ALIGN="LEFT">revision</TD></TR><TR><TD ALIGN="LEFT">account_filters</TD></TR><TR><TD ALIGN="LEFT">permitted_geographies</TD></TR><TR><TD ALIGN="LEFT">excluded_segments</TD></TR><TR><TD ALIGN="LEFT">membership_as_of_policy</TD></TR><TR><TD ALIGN="LEFT">selection_reason_codes</TD></TR></TABLE>>];
"OfferDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>OfferDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">offer_id</TD></TR><TR><TD ALIGN="LEFT">revision</TD></TR><TR><TD ALIGN="LEFT">service_line</TD></TR><TR><TD ALIGN="LEFT">supported_problem_classes</TD></TR><TR><TD ALIGN="LEFT">prerequisites</TD></TR><TR><TD ALIGN="LEFT">allowed_template_refs</TD></TR><TR><TD ALIGN="LEFT">persona_rules</TD></TR><TR><TD ALIGN="LEFT">restrictions</TD></TR></TABLE>>];
"TimeWindow" -> "UseGateDecision" [style=invis];
"UseGateDecision" -> "UseRestriction" [style=invis];
"UseRestriction" -> "ProgramDefinition" [style=invis];
"ProgramDefinition" -> "AudienceDefinition" [style=invis];
"AudienceDefinition" -> "OfferDefinition" [style=invis];
}