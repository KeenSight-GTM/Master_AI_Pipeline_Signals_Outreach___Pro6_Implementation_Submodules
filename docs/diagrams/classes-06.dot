digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"FingerprintDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>FingerprintDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">authority</TD></TR><TR><TD ALIGN="LEFT">calibration_ref</TD></TR><TR><TD ALIGN="LEFT">capture_mode</TD></TR><TR><TD ALIGN="LEFT">emits</TD></TR><TR><TD ALIGN="LEFT">fingerprint_id</TD></TR><TR><TD ALIGN="LEFT">fixture_only</TD></TR><TR><TD ALIGN="LEFT">implementation_status</TD></TR><TR><TD ALIGN="LEFT">match_value</TD></TR><TR><TD ALIGN="LEFT">negative_fixtures</TD></TR><TR><TD ALIGN="LEFT">operator</TD></TR><TR><TD ALIGN="LEFT">positive_fixtures</TD></TR><TR><TD ALIGN="LEFT">product_subject_id</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR></TABLE>>];
"FunctionDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>FunctionDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">authority</TD></TR><TR><TD ALIGN="LEFT">cross_subject_rule</TD></TR><TR><TD ALIGN="LEFT">detector_contract</TD></TR><TR><TD ALIGN="LEFT">entrypoint</TD></TR><TR><TD ALIGN="LEFT">fixture_only</TD></TR><TR><TD ALIGN="LEFT">function_id</TD></TR><TR><TD ALIGN="LEFT">implementation_status</TD></TR><TR><TD ALIGN="LEFT">input_predicates</TD></TR><TR><TD ALIGN="LEFT">output_predicates</TD></TR><TR><TD ALIGN="LEFT">parameter_schema</TD></TR><TR><TD ALIGN="LEFT">processor</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR></TABLE>>];
"GroundedClause" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>GroundedClause</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">clause_id</TD></TR><TR><TD ALIGN="LEFT">evidence_roles</TD></TR><TR><TD ALIGN="LEFT">fact_ids</TD></TR><TR><TD ALIGN="LEFT">template_id</TD></TR><TR><TD ALIGN="LEFT">text</TD></TR></TABLE>>];
"HypothesisValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>HypothesisValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">alternatives</TD></TR><TR><TD ALIGN="LEFT">conclusion</TD></TR><TR><TD ALIGN="LEFT">hypothesis_id</TD></TR><TR><TD ALIGN="LEFT">limitations</TD></TR><TR><TD ALIGN="LEFT">verification_question</TD></TR></TABLE>>];
"IntakeRequest" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>IntakeRequest</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">idempotency_key</TD></TR><TR><TD ALIGN="LEFT">intake_id</TD></TR><TR><TD ALIGN="LEFT">profile_id</TD></TR><TR><TD ALIGN="LEFT">purpose</TD></TR><TR><TD ALIGN="LEFT">received_at</TD></TR><TR><TD ALIGN="LEFT">request_hash</TD></TR><TR><TD ALIGN="LEFT">requester_id</TD></TR><TR><TD ALIGN="LEFT">targets</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"IntakeTarget" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>IntakeTarget</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">resource_uri</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR></TABLE>>];
"FingerprintDefinition" -> "FunctionDefinition" [style=invis];
"FunctionDefinition" -> "GroundedClause" [style=invis];
"GroundedClause" -> "HypothesisValue" [style=invis];
"HypothesisValue" -> "IntakeRequest" [style=invis];
"IntakeRequest" -> "IntakeTarget" [style=invis];
}