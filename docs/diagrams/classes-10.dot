digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"ReviewDecision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ReviewDecision</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">action</TD></TR><TR><TD ALIGN="LEFT">decided_at</TD></TR><TR><TD ALIGN="LEFT">package</TD></TR><TR><TD ALIGN="LEFT">policy_version</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">review_id</TD></TR><TR><TD ALIGN="LEFT">reviewer_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"ReviewRecordValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ReviewRecordValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">edited</TD></TR><TR><TD ALIGN="LEFT">language</TD></TR><TR><TD ALIGN="LEFT">platform</TD></TR><TR><TD ALIGN="LEFT">published_at</TD></TR><TR><TD ALIGN="LEFT">rating</TD></TR><TR><TD ALIGN="LEFT">rating_scale_max</TD></TR><TR><TD ALIGN="LEFT">review_key</TD></TR><TR><TD ALIGN="LEFT">text</TD></TR></TABLE>>];
"SalaryValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SalaryValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">basis</TD></TR><TR><TD ALIGN="LEFT">currency</TD></TR><TR><TD ALIGN="LEFT">maximum_minor</TD></TR><TR><TD ALIGN="LEFT">minimum_minor</TD></TR><TR><TD ALIGN="LEFT">minor_unit_exponent</TD></TR><TR><TD ALIGN="LEFT">period</TD></TR></TABLE>>];
"SampleRecordDecision" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>SampleRecordDecision</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">artifact_id</TD></TR><TR><TD ALIGN="LEFT">classification_fact_ids</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
"ScenarioEstimate" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ScenarioEstimate</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">assumptions</TD></TR><TR><TD ALIGN="LEFT">currency</TD></TR><TR><TD ALIGN="LEFT">formula_version</TD></TR><TR><TD ALIGN="LEFT">implementation_status</TD></TR><TR><TD ALIGN="LEFT">limitations</TD></TR><TR><TD ALIGN="LEFT">lower_minor</TD></TR><TR><TD ALIGN="LEFT">observed_input_fact_ids</TD></TR><TR><TD ALIGN="LEFT">scenario_id</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">time_period</TD></TR><TR><TD ALIGN="LEFT">upper_minor</TD></TR><TR><TD ALIGN="LEFT">verified_loss</TD></TR></TABLE>>];
"Scope" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>Scope</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">capture_mode</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">population_description</TD></TR><TR><TD ALIGN="LEFT">resources</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">stable_scope_key</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"ReviewDecision" -> "ReviewRecordValue" [style=invis];
"ReviewRecordValue" -> "SalaryValue" [style=invis];
"SalaryValue" -> "SampleRecordDecision" [style=invis];
"SampleRecordDecision" -> "ScenarioEstimate" [style=invis];
"ScenarioEstimate" -> "Scope" [style=invis];
}