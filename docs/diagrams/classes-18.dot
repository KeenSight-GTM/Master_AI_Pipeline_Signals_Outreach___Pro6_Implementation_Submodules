digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"ExperimentDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ExperimentDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">experiment_id</TD></TR><TR><TD ALIGN="LEFT">hypothesis</TD></TR><TR><TD ALIGN="LEFT">eligible_population</TD></TR><TR><TD ALIGN="LEFT">randomization_or_observational_design</TD></TR><TR><TD ALIGN="LEFT">treatment_refs</TD></TR><TR><TD ALIGN="LEFT">holdout_policy</TD></TR><TR><TD ALIGN="LEFT">outcome_definition</TD></TR><TR><TD ALIGN="LEFT">maturity_window</TD></TR><TR><TD ALIGN="LEFT">stopping_rule</TD></TR></TABLE>>];
"ExperimentAssignment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ExperimentAssignment</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">assignment_id</TD></TR><TR><TD ALIGN="LEFT">experiment_ref</TD></TR><TR><TD ALIGN="LEFT">unit_ref</TD></TR><TR><TD ALIGN="LEFT">assigned_variant</TD></TR><TR><TD ALIGN="LEFT">assignment_rule_version</TD></TR><TR><TD ALIGN="LEFT">assigned_at</TD></TR><TR><TD ALIGN="LEFT">exposure_links</TD></TR></TABLE>>];
"QualityAssessment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>QualityAssessment</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">assessment_id</TD></TR><TR><TD ALIGN="LEFT">evaluated_release_refs</TD></TR><TR><TD ALIGN="LEFT">gold_set_ref</TD></TR><TR><TD ALIGN="LEFT">eligible_sample</TD></TR><TR><TD ALIGN="LEFT">observed_metrics</TD></TR><TR><TD ALIGN="LEFT">errors</TD></TR><TR><TD ALIGN="LEFT">uncertainty</TD></TR><TR><TD ALIGN="LEFT">limitations</TD></TR></TABLE>>];
"PromotionProposal" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>PromotionProposal</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">proposal_id</TD></TR><TR><TD ALIGN="LEFT">target_definition_ref</TD></TR><TR><TD ALIGN="LEFT">assessed_release_ref</TD></TR><TR><TD ALIGN="LEFT">quality_assessment_refs</TD></TR><TR><TD ALIGN="LEFT">intended_change</TD></TR><TR><TD ALIGN="LEFT">reasons</TD></TR><TR><TD ALIGN="LEFT">review_requirements</TD></TR></TABLE>>];
"WorkspaceView" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>WorkspaceView</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">view_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">view_kind</TD></TR><TR><TD ALIGN="LEFT">permitted_record_refs</TD></TR><TR><TD ALIGN="LEFT">as_of</TD></TR><TR><TD ALIGN="LEFT">redaction_policy_ref</TD></TR><TR><TD ALIGN="LEFT">completeness_notes</TD></TR></TABLE>>];
"Common" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>Common</B></TD></TR><TR><TD><FONT POINT-SIZE="9">DRAFT COMMON ENVELOPE</FONT></TD></TR></TABLE>>];
"ExperimentDefinition" -> "ExperimentAssignment" [style=invis];
"ExperimentAssignment" -> "QualityAssessment" [style=invis];
"QualityAssessment" -> "PromotionProposal" [style=invis];
"PromotionProposal" -> "WorkspaceView" [style=invis];
"WorkspaceView" -> "Common" [style=invis];
}