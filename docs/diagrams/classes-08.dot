digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"OutcomeEvent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>OutcomeEvent</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">attribution_status</TD></TR><TR><TD ALIGN="LEFT">event_id</TD></TR><TR><TD ALIGN="LEFT">evidence_id</TD></TR><TR><TD ALIGN="LEFT">exposure_id</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD></TR><TR><TD ALIGN="LEFT">provider</TD></TR><TR><TD ALIGN="LEFT">provider_event_id</TD></TR><TR><TD ALIGN="LEFT">received_at</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"OutreachPackage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>OutreachPackage</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">approved_at</TD></TR><TR><TD ALIGN="LEFT">clauses</TD></TR><TR><TD ALIGN="LEFT">context_ids</TD></TR><TR><TD ALIGN="LEFT">maturity_fact_id</TD></TR><TR><TD ALIGN="LEFT">package_id</TD></TR><TR><TD ALIGN="LEFT">rendered_text</TD></TR><TR><TD ALIGN="LEFT">review_id</TD></TR><TR><TD ALIGN="LEFT">revision</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">send_allowed</TD></TR><TR><TD ALIGN="LEFT">signal_ids</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">template_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"PackageReference" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>PackageReference</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">content_hash</TD></TR><TR><TD ALIGN="LEFT">package_id</TD></TR><TR><TD ALIGN="LEFT">revision</TD></TR></TABLE>>];
"PredicateDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>PredicateDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">absence_allowed</TD></TR><TR><TD ALIGN="LEFT">allowed_natures</TD></TR><TR><TD ALIGN="LEFT">allowed_processors</TD></TR><TR><TD ALIGN="LEFT">copy_policy</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">example_target</TD></TR><TR><TD ALIGN="LEFT">example_value</TD></TR><TR><TD ALIGN="LEFT">family</TD></TR><TR><TD ALIGN="LEFT">origin</TD></TR><TR><TD ALIGN="LEFT">predicate_id</TD></TR><TR><TD ALIGN="LEFT">reference_rules</TD></TR><TR><TD ALIGN="LEFT">section_ids</TD></TR><TR><TD ALIGN="LEFT">subject_kinds</TD></TR><TR><TD ALIGN="LEFT">target_schema</TD></TR><TR><TD ALIGN="LEFT">temporal_mode</TD></TR><TR><TD ALIGN="LEFT">value_class</TD></TR><TR><TD ALIGN="LEFT">value_schema</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR></TABLE>>];
"ProviderBlueprint" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ProviderBlueprint</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">adapter_implemented</TD></TR><TR><TD ALIGN="LEFT">approval_required</TD></TR><TR><TD ALIGN="LEFT">blueprint_id</TD></TR><TR><TD ALIGN="LEFT">families</TD></TR><TR><TD ALIGN="LEFT">methods</TD></TR><TR><TD ALIGN="LEFT">notes</TD></TR><TR><TD ALIGN="LEFT">provider</TD></TR><TR><TD ALIGN="LEFT">section_ids</TD></TR><TR><TD ALIGN="LEFT">terms_url</TD></TR></TABLE>>];
"PublishedRecordValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>PublishedRecordValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">namespace</TD></TR><TR><TD ALIGN="LEFT">published_at</TD></TR><TR><TD ALIGN="LEFT">publisher</TD></TR><TR><TD ALIGN="LEFT">record_id</TD></TR><TR><TD ALIGN="LEFT">record_type</TD></TR><TR><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">url</TD></TR></TABLE>>];
"OutcomeEvent" -> "OutreachPackage" [style=invis];
"OutreachPackage" -> "PackageReference" [style=invis];
"PackageReference" -> "PredicateDefinition" [style=invis];
"PredicateDefinition" -> "ProviderBlueprint" [style=invis];
"ProviderBlueprint" -> "PublishedRecordValue" [style=invis];
}