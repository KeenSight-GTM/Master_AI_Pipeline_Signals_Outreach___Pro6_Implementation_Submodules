digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"CampaignDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CampaignDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">campaign_id</TD></TR><TR><TD ALIGN="LEFT">revision</TD></TR><TR><TD ALIGN="LEFT">program_ref</TD></TR><TR><TD ALIGN="LEFT">route_ref</TD></TR><TR><TD ALIGN="LEFT">ordered_step_definitions</TD></TR><TR><TD ALIGN="LEFT">template_refs</TD></TR><TR><TD ALIGN="LEFT">schedule_owner</TD></TR><TR><TD ALIGN="LEFT">send_window_policy</TD></TR><TR><TD ALIGN="LEFT">timezone_policy</TD></TR><TR><TD ALIGN="LEFT">sender_constraints</TD></TR><TR><TD ALIGN="LEFT">stop_policy</TD></TR><TR><TD ALIGN="LEFT">frequency_caps</TD></TR></TABLE>>];
"CampaignApproval" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CampaignApproval</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">approval_id</TD></TR><TR><TD ALIGN="LEFT">campaign_id</TD></TR><TR><TD ALIGN="LEFT">revision</TD></TR><TR><TD ALIGN="LEFT">definition_hash</TD></TR><TR><TD ALIGN="LEFT">authorized_actor</TD></TR><TR><TD ALIGN="LEFT">allowed_mode</TD></TR><TR><TD ALIGN="LEFT">approved_at</TD></TR><TR><TD ALIGN="LEFT">policy_ref</TD></TR></TABLE>>];
"CampaignReadiness" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CampaignReadiness</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">readiness_id</TD></TR><TR><TD ALIGN="LEFT">campaign_ref</TD></TR><TR><TD ALIGN="LEFT">sender_snapshot_refs</TD></TR><TR><TD ALIGN="LEFT">provider_state_refs</TD></TR><TR><TD ALIGN="LEFT">compatibility_checks</TD></TR><TR><TD ALIGN="LEFT">checked_at</TD></TR><TR><TD ALIGN="LEFT">decision</TD></TR><TR><TD ALIGN="LEFT">reasons</TD></TR></TABLE>>];
"Enrollment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>Enrollment</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">enrollment_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">campaign_ref</TD></TR><TR><TD ALIGN="LEFT">account_ref</TD></TR><TR><TD ALIGN="LEFT">contact_ref</TD></TR><TR><TD ALIGN="LEFT">enrollment_policy_ref</TD></TR><TR><TD ALIGN="LEFT">state</TD></TR><TR><TD ALIGN="LEFT">next_step_id</TD></TR><TR><TD ALIGN="LEFT">state_revision</TD></TR><TR><TD ALIGN="LEFT">enrolled_at</TD></TR><TR><TD ALIGN="LEFT">last_event_ref</TD></TR></TABLE>>];
"StepEligibility" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>StepEligibility</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">eligibility_id</TD></TR><TR><TD ALIGN="LEFT">enrollment_ref</TD></TR><TR><TD ALIGN="LEFT">step_id</TD></TR><TR><TD ALIGN="LEFT">due_at</TD></TR><TR><TD ALIGN="LEFT">timezone_basis</TD></TR><TR><TD ALIGN="LEFT">package_ref</TD></TR><TR><TD ALIGN="LEFT">contact_assessment_ref</TD></TR><TR><TD ALIGN="LEFT">cap_reservation_ref</TD></TR><TR><TD ALIGN="LEFT">state_revision</TD></TR><TR><TD ALIGN="LEFT">decision</TD></TR><TR><TD ALIGN="LEFT">reasons</TD></TR></TABLE>>];
"DeliveryIntent" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>DeliveryIntent</B></TD></TR><TR><TD><FONT POINT-SIZE="9">PROPOSED PRODUCT RECORD</FONT></TD></TR><TR><TD ALIGN="LEFT">intent_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">enrollment_ref</TD></TR><TR><TD ALIGN="LEFT">step_id</TD></TR><TR><TD ALIGN="LEFT">recipient_binding_ref</TD></TR><TR><TD ALIGN="LEFT">channel</TD></TR><TR><TD ALIGN="LEFT">reviewed_message_ref</TD></TR><TR><TD ALIGN="LEFT">logical_effect_key</TD></TR><TR><TD ALIGN="LEFT">execution_owner</TD></TR></TABLE>>];
"CampaignDefinition" -> "CampaignApproval" [style=invis];
"CampaignApproval" -> "CampaignReadiness" [style=invis];
"CampaignReadiness" -> "Enrollment" [style=invis];
"Enrollment" -> "StepEligibility" [style=invis];
"StepEligibility" -> "DeliveryIntent" [style=invis];
}