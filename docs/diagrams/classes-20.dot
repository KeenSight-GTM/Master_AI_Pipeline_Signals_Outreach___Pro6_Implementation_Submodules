digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"CollectorPageEvidence" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CollectorPageEvidence</B></TD></TR><TR><TD><FONT POINT-SIZE="9">IMPLEMENTED DATACLASS (COLLECTOR)</FONT></TD></TR><TR><TD ALIGN="LEFT">capture</TD></TR><TR><TD ALIGN="LEFT">surfaces</TD></TR><TR><TD ALIGN="LEFT">commands</TD></TR></TABLE>>];
"CollectorMatch" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CollectorMatch</B></TD></TR><TR><TD><FONT POINT-SIZE="9">IMPLEMENTED DATACLASS (COLLECTOR)</FONT></TD></TR><TR><TD ALIGN="LEFT">match_id</TD></TR><TR><TD ALIGN="LEFT">rule_id</TD></TR><TR><TD ALIGN="LEFT">rule_digest</TD></TR><TR><TD ALIGN="LEFT">release_digest</TD></TR><TR><TD ALIGN="LEFT">authority</TD></TR><TR><TD ALIGN="LEFT">capture_id</TD></TR><TR><TD ALIGN="LEFT">surface_id</TD></TR><TR><TD ALIGN="LEFT">branch</TD></TR><TR><TD ALIGN="LEFT">predicate</TD></TR><TR><TD ALIGN="LEFT">product_id</TD></TR><TR><TD ALIGN="LEFT">object_value</TD></TR><TR><TD ALIGN="LEFT">evidence_key</TD></TR><TR><TD ALIGN="LEFT">rule_evidence_key</TD></TR><TR><TD ALIGN="LEFT">authored_confidence</TD></TR></TABLE>>];
"CollectorObservation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CollectorObservation</B></TD></TR><TR><TD><FONT POINT-SIZE="9">IMPLEMENTED DATACLASS (COLLECTOR)</FONT></TD></TR><TR><TD ALIGN="LEFT">observation_id</TD></TR><TR><TD ALIGN="LEFT">claim_key</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">predicate</TD></TR><TR><TD ALIGN="LEFT">target</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">nature</TD></TR><TR><TD ALIGN="LEFT">state</TD></TR><TR><TD ALIGN="LEFT">object_value</TD></TR><TR><TD ALIGN="LEFT">capture_id</TD></TR><TR><TD ALIGN="LEFT">source_id</TD></TR><TR><TD ALIGN="LEFT">source_group</TD></TR><TR><TD ALIGN="LEFT">observed_at</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD></TR></TABLE>>];
"CollectorSupportLink" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CollectorSupportLink</B></TD></TR><TR><TD><FONT POINT-SIZE="9">IMPLEMENTED DATACLASS (COLLECTOR)</FONT></TD></TR><TR><TD ALIGN="LEFT">observation_id</TD></TR><TR><TD ALIGN="LEFT">match_id</TD></TR></TABLE>>];
"CollectorClaimView" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CollectorClaimView</B></TD></TR><TR><TD><FONT POINT-SIZE="9">IMPLEMENTED DATACLASS (COLLECTOR)</FONT></TD></TR><TR><TD ALIGN="LEFT">claim_key</TD></TR><TR><TD ALIGN="LEFT">predicate</TD></TR><TR><TD ALIGN="LEFT">target</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">object_value</TD></TR><TR><TD ALIGN="LEFT">observation_ids</TD></TR><TR><TD ALIGN="LEFT">supporting_match_ids</TD></TR><TR><TD ALIGN="LEFT">eligible_match_ids</TD></TR><TR><TD ALIGN="LEFT">rule_ids</TD></TR><TR><TD ALIGN="LEFT">capture_count</TD></TR><TR><TD ALIGN="LEFT">source_group_count</TD></TR><TR><TD ALIGN="LEFT">evidence_count</TD></TR><TR><TD ALIGN="LEFT">confidence</TD></TR><TR><TD ALIGN="LEFT">confidence_policy</TD></TR></TABLE>>];
"CollectorPageEvidence" -> "CollectorMatch" [style=invis];
"CollectorMatch" -> "CollectorObservation" [style=invis];
"CollectorObservation" -> "CollectorSupportLink" [style=invis];
"CollectorSupportLink" -> "CollectorClaimView" [style=invis];
}