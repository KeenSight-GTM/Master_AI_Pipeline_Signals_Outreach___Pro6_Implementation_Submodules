digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"Diagnostic" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>Diagnostic</B></TD></TR><TR><TD><FONT POINT-SIZE="9">DRAFT COMMON ENVELOPE</FONT></TD></TR><TR><TD ALIGN="LEFT">cause_execution_id</TD></TR><TR><TD ALIGN="LEFT">code</TD></TR><TR><TD ALIGN="LEFT">diagnostic_id</TD></TR><TR><TD ALIGN="LEFT">field_path</TD></TR><TR><TD ALIGN="LEFT">message</TD></TR><TR><TD ALIGN="LEFT">record_refs</TD></TR><TR><TD ALIGN="LEFT">restricted_details_ref</TD></TR><TR><TD ALIGN="LEFT">severity</TD></TR><TR><TD ALIGN="LEFT">suggested_action</TD></TR></TABLE>>];
"ModuleRequest" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ModuleRequest</B></TD></TR><TR><TD><FONT POINT-SIZE="9">DRAFT COMMON ENVELOPE</FONT></TD></TR><TR><TD ALIGN="LEFT">attempt</TD></TR><TR><TD ALIGN="LEFT">budget_reservation_ref</TD></TR><TR><TD ALIGN="LEFT">context</TD></TR><TR><TD ALIGN="LEFT">deadline_at</TD></TR><TR><TD ALIGN="LEFT">execution_id</TD></TR><TR><TD ALIGN="LEFT">idempotency_key</TD></TR><TR><TD ALIGN="LEFT">input_refs</TD></TR><TR><TD ALIGN="LEFT">module_id</TD></TR><TR><TD ALIGN="LEFT">operation</TD></TR><TR><TD ALIGN="LEFT">parameters_ref</TD></TR><TR><TD ALIGN="LEFT">protocol_version</TD></TR><TR><TD ALIGN="LEFT">release_lock_ref</TD></TR><TR><TD ALIGN="LEFT">request_id</TD></TR><TR><TD ALIGN="LEFT">trace</TD></TR></TABLE>>];
"ModuleResult" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ModuleResult</B></TD></TR><TR><TD><FONT POINT-SIZE="9">DRAFT COMMON ENVELOPE</FONT></TD></TR><TR><TD ALIGN="LEFT">consumed_refs</TD></TR><TR><TD ALIGN="LEFT">context</TD></TR><TR><TD ALIGN="LEFT">diagnostic_record_refs</TD></TR><TR><TD ALIGN="LEFT">diagnostics</TD></TR><TR><TD ALIGN="LEFT">execution_id</TD></TR><TR><TD ALIGN="LEFT">execution_status</TD></TR><TR><TD ALIGN="LEFT">finished_at</TD></TR><TR><TD ALIGN="LEFT">module_id</TD></TR><TR><TD ALIGN="LEFT">operation</TD></TR><TR><TD ALIGN="LEFT">output_refs</TD></TR><TR><TD ALIGN="LEFT">protocol_version</TD></TR><TR><TD ALIGN="LEFT">request_digest</TD></TR><TR><TD ALIGN="LEFT">request_id</TD></TR><TR><TD ALIGN="LEFT">reused_execution_id</TD></TR><TR><TD ALIGN="LEFT">started_at</TD></TR><TR><TD ALIGN="LEFT">trace</TD></TR><TR><TD ALIGN="LEFT">usage</TD></TR></TABLE>>];
"CollectorCapture" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CollectorCapture</B></TD></TR><TR><TD><FONT POINT-SIZE="9">IMPLEMENTED DATACLASS (COLLECTOR)</FONT></TD></TR><TR><TD ALIGN="LEFT">capture_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">url</TD></TR><TR><TD ALIGN="LEFT">observed_at</TD></TR><TR><TD ALIGN="LEFT">mode</TD></TR><TR><TD ALIGN="LEFT">status_code</TD></TR><TR><TD ALIGN="LEFT">body_sha256</TD></TR><TR><TD ALIGN="LEFT">body_path</TD></TR><TR><TD ALIGN="LEFT">headers</TD></TR><TR><TD ALIGN="LEFT">complete</TD></TR><TR><TD ALIGN="LEFT">source_id</TD></TR><TR><TD ALIGN="LEFT">limitations</TD></TR><TR><TD ALIGN="LEFT">source_ttl_seconds</TD></TR></TABLE>>];
"CollectorSurface" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CollectorSurface</B></TD></TR><TR><TD><FONT POINT-SIZE="9">IMPLEMENTED DATACLASS (COLLECTOR)</FONT></TD></TR><TR><TD ALIGN="LEFT">surface_id</TD></TR><TR><TD ALIGN="LEFT">capture_id</TD></TR><TR><TD ALIGN="LEFT">command_id</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">locator</TD></TR><TR><TD ALIGN="LEFT">value</TD></TR><TR><TD ALIGN="LEFT">context</TD></TR><TR><TD ALIGN="LEFT">attributes</TD></TR></TABLE>>];
"CollectorCommandResult" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CollectorCommandResult</B></TD></TR><TR><TD><FONT POINT-SIZE="9">IMPLEMENTED DATACLASS (COLLECTOR)</FONT></TD></TR><TR><TD ALIGN="LEFT">command_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">input_ids</TD></TR><TR><TD ALIGN="LEFT">output_ids</TD></TR><TR><TD ALIGN="LEFT">limitations</TD></TR><TR><TD ALIGN="LEFT">details</TD></TR></TABLE>>];
"Diagnostic" -> "ModuleRequest" [style=invis];
"ModuleRequest" -> "ModuleResult" [style=invis];
"ModuleResult" -> "CollectorCapture" [style=invis];
"CollectorCapture" -> "CollectorSurface" [style=invis];
"CollectorSurface" -> "CollectorCommandResult" [style=invis];
}