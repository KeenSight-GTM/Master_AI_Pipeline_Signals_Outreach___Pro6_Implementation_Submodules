digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"ExecutionRecord" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ExecutionRecord</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">execution_id</TD></TR><TR><TD ALIGN="LEFT">finished_at</TD></TR><TR><TD ALIGN="LEFT">function_id</TD></TR><TR><TD ALIGN="LEFT">function_version</TD></TR><TR><TD ALIGN="LEFT">input_artifact_ids</TD></TR><TR><TD ALIGN="LEFT">input_fact_ids</TD></TR><TR><TD ALIGN="LEFT">input_sample_ids</TD></TR><TR><TD ALIGN="LEFT">input_set_hash</TD></TR><TR><TD ALIGN="LEFT">model_call_id</TD></TR><TR><TD ALIGN="LEFT">output_artifact_ids</TD></TR><TR><TD ALIGN="LEFT">output_fact_ids</TD></TR><TR><TD ALIGN="LEFT">parameters</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">sample_set_hash</TD></TR><TR><TD ALIGN="LEFT">started_at</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">terminal_reason</TD></TR></TABLE>>];
"ExportReceipt" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ExportReceipt</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">actor_id</TD></TR><TR><TD ALIGN="LEFT">automatic_sending</TD></TR><TR><TD ALIGN="LEFT">completed_at</TD></TR><TR><TD ALIGN="LEFT">destination_id</TD></TR><TR><TD ALIGN="LEFT">export_id</TD></TR><TR><TD ALIGN="LEFT">external_reference</TD></TR><TR><TD ALIGN="LEFT">gate_id</TD></TR><TR><TD ALIGN="LEFT">idempotency_key</TD></TR><TR><TD ALIGN="LEFT">mapping_version</TD></TR><TR><TD ALIGN="LEFT">package</TD></TR><TR><TD ALIGN="LEFT">payload_hash</TD></TR><TR><TD ALIGN="LEFT">payload_ref</TD></TR><TR><TD ALIGN="LEFT">recipient_key</TD></TR><TR><TD ALIGN="LEFT">requested_at</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"Exposure" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>Exposure</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">accepted_at</TD></TR><TR><TD ALIGN="LEFT">business_send_key</TD></TR><TR><TD ALIGN="LEFT">exposure_id</TD></TR><TR><TD ALIGN="LEFT">package_id</TD></TR><TR><TD ALIGN="LEFT">provider_message_id</TD></TR><TR><TD ALIGN="LEFT">recipient_key</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"ExternalIdentifier" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ExternalIdentifier</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">namespace</TD></TR><TR><TD ALIGN="LEFT">value</TD></TR></TABLE>>];
"Fact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>Fact</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">binding_id</TD></TR><TR><TD ALIGN="LEFT">confidence</TD></TR><TR><TD ALIGN="LEFT">effective_at</TD></TR><TR><TD ALIGN="LEFT">evidence_id</TD></TR><TR><TD ALIGN="LEFT">execution_id</TD></TR><TR><TD ALIGN="LEFT">expires_at</TD></TR><TR><TD ALIGN="LEFT">fact_id</TD></TR><TR><TD ALIGN="LEFT">nature</TD></TR><TR><TD ALIGN="LEFT">object</TD></TR><TR><TD ALIGN="LEFT">observed_at</TD></TR><TR><TD ALIGN="LEFT">predicate_id</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">recorded_at</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">schema_version</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">source_id</TD></TR><TR><TD ALIGN="LEFT">state</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">supersedes_fact_id</TD></TR><TR><TD ALIGN="LEFT">target</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">window</TD></TR></TABLE>>];
"FactRequirement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>FactRequirement</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">allowed_natures</TD></TR><TR><TD ALIGN="LEFT">counting_unit</TD></TR><TR><TD ALIGN="LEFT">minimum</TD></TR><TR><TD ALIGN="LEFT">predicate_id</TD></TR><TR><TD ALIGN="LEFT">state</TD></TR></TABLE>>];
"ExecutionRecord" -> "ExportReceipt" [style=invis];
"ExportReceipt" -> "Exposure" [style=invis];
"Exposure" -> "ExternalIdentifier" [style=invis];
"ExternalIdentifier" -> "Fact" [style=invis];
"Fact" -> "FactRequirement" [style=invis];
}