digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"QuotedTextResult" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>QuotedTextResult</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">text</TD></TR></TABLE>>];
"RegistryRecordValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>RegistryRecordValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">effective_at</TD></TR><TR><TD ALIGN="LEFT">filed_at</TD></TR><TR><TD ALIGN="LEFT">issuer</TD></TR><TR><TD ALIGN="LEFT">jurisdiction</TD></TR><TR><TD ALIGN="LEFT">namespace</TD></TR><TR><TD ALIGN="LEFT">record_id</TD></TR><TR><TD ALIGN="LEFT">record_status</TD></TR></TABLE>>];
"RepairAttempt" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>RepairAttempt</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">attempt_id</TD></TR><TR><TD ALIGN="LEFT">call_id</TD></TR><TR><TD ALIGN="LEFT">input_response_artifact_id</TD></TR><TR><TD ALIGN="LEFT">method</TD></TR><TR><TD ALIGN="LEFT">ordinal</TD></TR><TR><TD ALIGN="LEFT">output_response_artifact_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">validation_errors</TD></TR></TABLE>>];
"ResearchPriorValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ResearchPriorValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">classified_eligible_count</TD></TR><TR><TD ALIGN="LEFT">contradicting_fact_ids</TD></TR><TR><TD ALIGN="LEFT">denominator_definition</TD></TR><TR><TD ALIGN="LEFT">eligible_count</TD></TR><TR><TD ALIGN="LEFT">population_claim</TD></TR><TR><TD ALIGN="LEFT">sample_id</TD></TR><TR><TD ALIGN="LEFT">sample_share</TD></TR><TR><TD ALIGN="LEFT">support_count</TD></TR><TR><TD ALIGN="LEFT">support_policy_id</TD></TR><TR><TD ALIGN="LEFT">supporting_fact_ids</TD></TR><TR><TD ALIGN="LEFT">theme_id</TD></TR><TR><TD ALIGN="LEFT">unclassified_count</TD></TR></TABLE>>];
"ResearchSample" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ResearchSample</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">complete_population</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT">dedupe_policy_version</TD></TR><TR><TD ALIGN="LEFT">eligible_artifact_ids</TD></TR><TR><TD ALIGN="LEFT">excluded_artifact_ids</TD></TR><TR><TD ALIGN="LEFT">limitations</TD></TR><TR><TD ALIGN="LEFT">policy_ids</TD></TR><TR><TD ALIGN="LEFT">population_size</TD></TR><TR><TD ALIGN="LEFT">record_decisions</TD></TR><TR><TD ALIGN="LEFT">retrieved_artifact_ids</TD></TR><TR><TD ALIGN="LEFT">sample_id</TD></TR><TR><TD ALIGN="LEFT">sampling_frame</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">selection_method</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">support_policy_id</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR><TR><TD ALIGN="LEFT">theme_id</TD></TR><TR><TD ALIGN="LEFT">window</TD></TR></TABLE>>];
"ResearchSupportPolicy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ResearchSupportPolicy</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">allowed_sentiments</TD></TR><TR><TD ALIGN="LEFT">allowed_stances</TD></TR><TR><TD ALIGN="LEFT">counting_unit</TD></TR><TR><TD ALIGN="LEFT">denominator_rule</TD></TR><TR><TD ALIGN="LEFT">meaning</TD></TR><TR><TD ALIGN="LEFT">support_policy_id</TD></TR><TR><TD ALIGN="LEFT">unclassified_policy</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR></TABLE>>];
"QuotedTextResult" -> "RegistryRecordValue" [style=invis];
"RegistryRecordValue" -> "RepairAttempt" [style=invis];
"RepairAttempt" -> "ResearchPriorValue" [style=invis];
"ResearchPriorValue" -> "ResearchSample" [style=invis];
"ResearchSample" -> "ResearchSupportPolicy" [style=invis];
}