digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"CallEventValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CallEventValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">call_key</TD></TR><TR><TD ALIGN="LEFT">callback_of</TD></TR><TR><TD ALIGN="LEFT">direction</TD></TR><TR><TD ALIGN="LEFT">duration_seconds</TD></TR><TR><TD ALIGN="LEFT">started_at</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
"CandidateRecord" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CandidateRecord</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">artifact_id</TD></TR><TR><TD ALIGN="LEFT">attempt_id</TD></TR><TR><TD ALIGN="LEFT">candidate_id</TD></TR><TR><TD ALIGN="LEFT">production_eligible</TD></TR><TR><TD ALIGN="LEFT">proposed_predicate_id</TD></TR><TR><TD ALIGN="LEFT">proposed_value</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"CapabilityProfile" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CapabilityProfile</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">capture_source_ids</TD></TR><TR><TD ALIGN="LEFT">delivery_enabled</TD></TR><TR><TD ALIGN="LEFT">execute_function_ids</TD></TR><TR><TD ALIGN="LEFT">export_enabled</TD></TR><TR><TD ALIGN="LEFT">fact_predicate_ids</TD></TR><TR><TD ALIGN="LEFT">product_boundary</TD></TR><TR><TD ALIGN="LEFT">production_enabled</TD></TR><TR><TD ALIGN="LEFT">profile_id</TD></TR><TR><TD ALIGN="LEFT">research_context_enabled</TD></TR><TR><TD ALIGN="LEFT">signal_ids</TD></TR><TR><TD ALIGN="LEFT">template_ids</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR></TABLE>>];
"CaseStudyOutcomeValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>CaseStudyOutcomeValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">attribution</TD></TR><TR><TD ALIGN="LEFT">baseline_value</TD></TR><TR><TD ALIGN="LEFT">case_id</TD></TR><TR><TD ALIGN="LEFT">comparison_kind</TD></TR><TR><TD ALIGN="LEFT">measurement_window</TD></TR><TR><TD ALIGN="LEFT">method_description</TD></TR><TR><TD ALIGN="LEFT">metric_name</TD></TR><TR><TD ALIGN="LEFT">outcome_id</TD></TR><TR><TD ALIGN="LEFT">publisher</TD></TR><TR><TD ALIGN="LEFT">reported_quote</TD></TR><TR><TD ALIGN="LEFT">reported_value</TD></TR><TR><TD ALIGN="LEFT">sample_size</TD></TR><TR><TD ALIGN="LEFT">source_url</TD></TR><TR><TD ALIGN="LEFT">transfer_to_target_allowed</TD></TR><TR><TD ALIGN="LEFT">unit</TD></TR></TABLE>>];
"ChangeRecord" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ChangeRecord</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">actor_id</TD></TR><TR><TD ALIGN="LEFT">change_id</TD></TR><TR><TD ALIGN="LEFT">effective_at</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">reason</TD></TR><TR><TD ALIGN="LEFT">recorded_at</TD></TR><TR><TD ALIGN="LEFT">replacement_id</TD></TR><TR><TD ALIGN="LEFT">target_id</TD></TR><TR><TD ALIGN="LEFT">target_type</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"ClaimResolution" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>ClaimResolution</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">accepted_fact_ids</TD></TR><TR><TD ALIGN="LEFT">as_of</TD></TR><TR><TD ALIGN="LEFT">observation_ids</TD></TR><TR><TD ALIGN="LEFT">policy_version</TD></TR><TR><TD ALIGN="LEFT">predicate_id</TD></TR><TR><TD ALIGN="LEFT">resolution_id</TD></TR><TR><TD ALIGN="LEFT">resolved_at</TD></TR><TR><TD ALIGN="LEFT">run_id</TD></TR><TR><TD ALIGN="LEFT">scope_id</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">subject_id</TD></TR><TR><TD ALIGN="LEFT">target</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"CallEventValue" -> "CandidateRecord" [style=invis];
"CandidateRecord" -> "CapabilityProfile" [style=invis];
"CapabilityProfile" -> "CaseStudyOutcomeValue" [style=invis];
"CaseStudyOutcomeValue" -> "ChangeRecord" [style=invis];
"ChangeRecord" -> "ClaimResolution" [style=invis];
}