digraph G {
rankdir=LR;
graph [nodesep=0.35,ranksep=0.6];
node [shape=plain,fontname="DejaVu Sans",fontsize=11];
"DataAccessPolicy" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>DataAccessPolicy</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">allow_personal_data</TD></TR><TR><TD ALIGN="LEFT">allow_sensitive_data</TD></TR><TR><TD ALIGN="LEFT">approval_ref</TD></TR><TR><TD ALIGN="LEFT">attribution_text</TD></TR><TR><TD ALIGN="LEFT">deletion_cascades</TD></TR><TR><TD ALIGN="LEFT">fixture_only</TD></TR><TR><TD ALIGN="LEFT">max_derived_retention_seconds</TD></TR><TR><TD ALIGN="LEFT">max_raw_retention_seconds</TD></TR><TR><TD ALIGN="LEFT">policy_id</TD></TR><TR><TD ALIGN="LEFT">purposes</TD></TR><TR><TD ALIGN="LEFT">review_status</TD></TR><TR><TD ALIGN="LEFT">reviewed_at</TD></TR><TR><TD ALIGN="LEFT">tenant_ids</TD></TR><TR><TD ALIGN="LEFT">terms_ref</TD></TR><TR><TD ALIGN="LEFT">valid_until</TD></TR><TR><TD ALIGN="LEFT">version</TD></TR></TABLE>>];
"DestinationDefinition" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>DestinationDefinition</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">automatic_sending</TD></TR><TR><TD ALIGN="LEFT">destination_id</TD></TR><TR><TD ALIGN="LEFT">enabled</TD></TR><TR><TD ALIGN="LEFT">fixture_only</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">mapping_version</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"DiscussionRecordValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>DiscussionRecordValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">community</TD></TR><TR><TD ALIGN="LEFT">language</TD></TR><TR><TD ALIGN="LEFT">post_key</TD></TR><TR><TD ALIGN="LEFT">published_at</TD></TR><TR><TD ALIGN="LEFT">role</TD></TR><TR><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">thread_key</TD></TR></TABLE>>];
"EconomicHypothesisValue" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>EconomicHypothesisValue</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">assumptions</TD></TR><TR><TD ALIGN="LEFT">currency</TD></TR><TR><TD ALIGN="LEFT">estimated_amount_minor</TD></TR><TR><TD ALIGN="LEFT">limitations</TD></TR></TABLE>>];
"EvidenceLocator" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>EvidenceLocator</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">artifact_id</TD></TR><TR><TD ALIGN="LEFT">end</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">locator_id</TD></TR><TR><TD ALIGN="LEFT">pointer</TD></TR><TR><TD ALIGN="LEFT">quote</TD></TR><TR><TD ALIGN="LEFT">start</TD></TR></TABLE>>];
"EvidenceSet" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#e6edf3"><B>EvidenceSet</B></TD></TR><TR><TD><FONT POINT-SIZE="9">REFERENCE CONTRACT v4.2</FONT></TD></TR><TR><TD ALIGN="LEFT">attempt_id</TD></TR><TR><TD ALIGN="LEFT">coverage_id</TD></TR><TR><TD ALIGN="LEFT">directness</TD></TR><TR><TD ALIGN="LEFT">evidence_id</TD></TR><TR><TD ALIGN="LEFT">execution_id</TD></TR><TR><TD ALIGN="LEFT">input_fact_ids</TD></TR><TR><TD ALIGN="LEFT">locator_ids</TD></TR><TR><TD ALIGN="LEFT">sample_ids</TD></TR><TR><TD ALIGN="LEFT">tenant_id</TD></TR></TABLE>>];
"DataAccessPolicy" -> "DestinationDefinition" [style=invis];
"DestinationDefinition" -> "DiscussionRecordValue" [style=invis];
"DiscussionRecordValue" -> "EconomicHypothesisValue" [style=invis];
"EconomicHypothesisValue" -> "EvidenceLocator" [style=invis];
"EvidenceLocator" -> "EvidenceSet" [style=invis];
}