{
  "$id": "https://keensight.local/v4.2/ResearchSample.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "complete_population": {
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "dedupe_policy_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "eligible_artifact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "excluded_artifact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "policy_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "population_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "record_decisions": {
      "items": {
        "$ref": "https://keensight.local/v4.2/SampleRecordDecision.schema.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "retrieved_artifact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "sample_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "sampling_frame": {
      "minLength": 1,
      "type": "string"
    },
    "scope_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "selection_method": {
      "enum": [
        "CENSUS",
        "PROVIDER_SAMPLE",
        "QUERY_SAMPLE",
        "CURATED_SAMPLE"
      ]
    },
    "subject_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "support_policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "theme_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    }
  },
  "required": [
    "sample_id",
    "tenant_id",
    "subject_id",
    "scope_id",
    "window",
    "sampling_frame",
    "selection_method",
    "retrieved_artifact_ids",
    "eligible_artifact_ids",
    "excluded_artifact_ids",
    "dedupe_policy_version",
    "population_size",
    "complete_population",
    "limitations",
    "policy_ids",
    "support_policy_id",
    "theme_id",
    "record_decisions",
    "created_at"
  ],
  "title": "ResearchSample",
  "type": "object"
}
