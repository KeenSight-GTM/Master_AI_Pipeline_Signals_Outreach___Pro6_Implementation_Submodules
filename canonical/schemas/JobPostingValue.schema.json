{
  "$id": "https://keensight.local/v4.2/JobPostingValue.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "department": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "employment_type": {
      "anyOf": [
        {
          "enum": [
            "FULL_TIME",
            "PART_TIME",
            "CONTRACT",
            "TEMPORARY",
            "INTERNSHIP",
            "OTHER"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "namespace": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "posting_id": {
      "minLength": 1,
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "url": {
      "format": "uri",
      "type": "string"
    }
  },
  "required": [
    "posting_id",
    "namespace",
    "url",
    "title",
    "department",
    "published_at",
    "employment_type"
  ],
  "title": "JobPostingValue",
  "type": "object"
}
