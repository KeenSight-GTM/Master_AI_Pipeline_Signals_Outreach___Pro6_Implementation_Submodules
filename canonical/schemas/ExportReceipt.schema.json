{
  "$id": "https://keensight.local/v4.2/ExportReceipt.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "automatic_sending": {
      "const": false
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "export_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "external_reference": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "gate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "mapping_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "package_id",
        "revision",
        "content_hash"
      ],
      "type": "object"
    },
    "payload_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "payload_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "recipient_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "status": {
      "enum": [
        "PREPARED",
        "CONFIRMED",
        "UNKNOWN",
        "FAILED"
      ]
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "export_id",
    "tenant_id",
    "package",
    "gate_id",
    "destination_id",
    "mapping_version",
    "actor_id",
    "recipient_key",
    "payload_hash",
    "payload_ref",
    "idempotency_key",
    "requested_at",
    "completed_at",
    "status",
    "external_reference",
    "automatic_sending"
  ],
  "title": "ExportReceipt",
  "type": "object"
}
