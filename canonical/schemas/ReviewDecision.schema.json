{
  "$id": "https://keensight.local/v4.2/ReviewDecision.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "APPROVE",
        "REJECT",
        "REQUEST_CHANGE"
      ]
    },
    "decided_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "package_id",
        "revision",
        "content_hash"
      ],
      "type": "object"
    },
    "policy_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "review_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "reviewer_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "tenant_id",
    "reviewer_id",
    "package",
    "action",
    "reason",
    "decided_at",
    "policy_version"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
