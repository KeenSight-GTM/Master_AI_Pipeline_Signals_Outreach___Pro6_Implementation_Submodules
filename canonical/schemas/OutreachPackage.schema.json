{
  "$id": "https://keensight.local/v4.2/OutreachPackage.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "clauses": {
      "items": {
        "$ref": "https://keensight.local/v4.2/GroundedClause.schema.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "context_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "maturity_fact_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "package_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "rendered_text": {
      "minLength": 1,
      "type": "string"
    },
    "review_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "send_allowed": {
      "const": false
    },
    "signal_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "DRAFT",
        "DESIGN_TEST_APPROVED",
        "APPROVED",
        "WITHHELD"
      ]
    },
    "subject_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "template_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "package_id",
    "revision",
    "run_id",
    "tenant_id",
    "subject_id",
    "template_id",
    "clauses",
    "signal_ids",
    "context_ids",
    "maturity_fact_id",
    "status",
    "rendered_text",
    "approved_at",
    "send_allowed",
    "review_id"
  ],
  "title": "OutreachPackage",
  "type": "object"
}
