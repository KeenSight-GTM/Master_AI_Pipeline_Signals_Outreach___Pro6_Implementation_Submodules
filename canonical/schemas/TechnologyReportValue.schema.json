{
  "$id": "https://keensight.local/v4.2/TechnologyReportValue.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "product_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "provider_detected_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "reported_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "product_id",
    "provider",
    "provider_detected_at",
    "reported_version"
  ],
  "title": "TechnologyReportValue",
  "type": "object"
}
