{
  "$id": "https://keensight.local/v4.2/CoverageRecord.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "attempt_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "checked": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "resource": {
            "minLength": 1,
            "type": "string"
          },
          "result": {
            "enum": [
              "OK",
              "ERROR",
              "TIMEOUT",
              "DENIED",
              "NOT_VISITED"
            ]
          }
        },
        "required": [
          "resource",
          "artifact_id",
          "result"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "checked_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "coverage_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "detector_execution_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "detector_release": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "planned_resources": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "predicate_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "scope_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "scope_limitations": {
      "minLength": 1,
      "type": "string"
    },
    "source_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ]
    },
    "target": {
      "type": "object"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "coverage_id",
    "tenant_id",
    "scope_id",
    "source_id",
    "predicate_ids",
    "target",
    "planned_resources",
    "checked",
    "status",
    "checked_at",
    "detector_release",
    "scope_limitations",
    "attempt_ids",
    "detector_execution_id"
  ],
  "title": "CoverageRecord",
  "type": "object"
}
