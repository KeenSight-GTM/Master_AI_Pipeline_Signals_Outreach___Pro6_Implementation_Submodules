{
  "$id": "https://keensight.local/v4.2/BatchRun.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "approval_policy_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "binding_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "code_release": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "imported_execution_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "input_artifact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "input_fact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "intake_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "knowledge_cutoff": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "mode": {
      "enum": [
        "DESIGN_TEST",
        "PRODUCTION"
      ]
    },
    "produced_artifact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "produced_fact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "profile_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "registry_release": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "resolution_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "sample_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "sealed_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "status": {
      "enum": [
        "OPEN",
        "COMPLETE",
        "PARTIAL",
        "FAILED"
      ]
    },
    "target_results": {
      "items": {
        "$ref": "https://keensight.local/v4.2/TargetResult.schema.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "tenant_id",
    "mode",
    "as_of",
    "created_at",
    "code_release",
    "registry_release",
    "profile_id",
    "input_artifact_ids",
    "input_fact_ids",
    "binding_ids",
    "status",
    "approval_policy_version",
    "knowledge_cutoff",
    "sealed_at",
    "sample_ids",
    "resolution_ids",
    "target_results",
    "produced_fact_ids",
    "imported_execution_ids",
    "intake_id",
    "produced_artifact_ids"
  ],
  "title": "BatchRun",
  "type": "object"
}
