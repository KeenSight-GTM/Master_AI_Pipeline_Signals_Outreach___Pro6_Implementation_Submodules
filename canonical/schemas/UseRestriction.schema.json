{
  "$id": "https://keensight.local/v4.2/UseRestriction.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "kind": {
      "enum": [
        "DNC",
        "HOLD"
      ]
    },
    "reason": {
      "minLength": 1,
      "type": "string"
    },
    "recipient_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "released_at": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "released_by": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "restriction_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "subject_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "restriction_id",
    "tenant_id",
    "subject_id",
    "recipient_key",
    "kind",
    "actor_id",
    "effective_at",
    "released_at",
    "released_by",
    "reason"
  ],
  "title": "UseRestriction",
  "type": "object"
}
