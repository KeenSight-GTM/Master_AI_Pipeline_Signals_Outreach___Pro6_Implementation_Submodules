{
  "$id": "https://keensight.local/v4.2/CoverageCheck.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "resource": {
      "minLength": 1,
      "type": "string"
    },
    "result": {
      "enum": [
        "OK",
        "ERROR",
        "TIMEOUT",
        "DENIED",
        "NOT_VISITED"
      ]
    }
  },
  "required": [
    "resource",
    "artifact_id",
    "result"
  ],
  "title": "CoverageCheck",
  "type": "object"
}
