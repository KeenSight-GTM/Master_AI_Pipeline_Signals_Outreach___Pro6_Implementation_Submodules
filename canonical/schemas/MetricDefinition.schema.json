{
  "$id": "https://keensight.local/v4.2/MetricDefinition.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "aggregation": {
      "enum": [
        "COUNT",
        "SUM",
        "MEAN",
        "RATE",
        "RANK",
        "ESTIMATE",
        "DISTRIBUTION",
        "DESCRIPTIVE"
      ]
    },
    "allowed_natures": {
      "items": {
        "enum": [
          "DIRECT_OBSERVATION",
          "FIRST_PARTY_STATEMENT",
          "THIRD_PARTY_REPORT",
          "PROVIDER_ESTIMATE",
          "REGISTRY_RECORD",
          "INFERENCE",
          "DERIVED_MEASUREMENT"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "dimensions_schema": {
      "type": "object"
    },
    "metric_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "requires_denominator": {
      "type": "boolean"
    },
    "section_ids": {
      "items": {
        "maximum": 11,
        "minimum": 1,
        "type": "integer"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "subject_kinds": {
      "items": {
        "enum": [
          "ORG",
          "LOCATION",
          "PERSON",
          "BRAND",
          "WEBSITE",
          "SOFTWARE_PRODUCT",
          "INDUSTRY",
          "JOB_POSTING",
          "APPLICATION",
          "LISTING",
          "COHORT",
          "ANGLE"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "unit": {
      "minLength": 1,
      "type": "string"
    },
    "value_schema": {
      "type": "object"
    }
  },
  "required": [
    "metric_id",
    "description",
    "unit",
    "value_schema",
    "dimensions_schema",
    "requires_denominator",
    "aggregation",
    "allowed_natures",
    "subject_kinds",
    "section_ids"
  ],
  "title": "MetricDefinition",
  "type": "object"
}
