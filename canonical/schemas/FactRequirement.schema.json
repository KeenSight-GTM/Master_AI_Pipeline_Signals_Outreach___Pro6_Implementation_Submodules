{
  "$id": "https://keensight.local/v4.2/FactRequirement.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "allowed_natures": {
      "items": {
        "enum": [
          "DIRECT_OBSERVATION",
          "FIRST_PARTY_STATEMENT",
          "THIRD_PARTY_REPORT",
          "PROVIDER_ESTIMATE",
          "REGISTRY_RECORD",
          "INFERENCE",
          "DERIVED_MEASUREMENT"
        ]
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "counting_unit": {
      "const": "DISTINCT_ORIGIN"
    },
    "minimum": {
      "minimum": 1,
      "type": "integer"
    },
    "predicate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "state": {
      "enum": [
        "OBSERVED",
        "NOT_FOUND"
      ]
    }
  },
  "required": [
    "predicate_id",
    "allowed_natures",
    "state",
    "minimum",
    "counting_unit"
  ],
  "title": "FactRequirement",
  "type": "object"
}
