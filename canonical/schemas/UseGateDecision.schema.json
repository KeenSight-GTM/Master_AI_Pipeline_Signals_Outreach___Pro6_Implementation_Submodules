{
  "$id": "https://keensight.local/v4.2/UseGateDecision.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "BLOCK"
      ]
    },
    "destination_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "evaluated_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "gate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "package": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "package_id",
        "revision",
        "content_hash"
      ],
      "type": "object"
    },
    "purpose": {
      "enum": [
        "PREVIEW_EXPORT",
        "CONTACT_EXPORT"
      ]
    },
    "reasons": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "recipient_key": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "version_vector": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "gate_id",
    "tenant_id",
    "package",
    "review_id",
    "actor_id",
    "purpose",
    "destination_id",
    "recipient_key",
    "evaluated_at",
    "valid_until",
    "version_vector",
    "decision",
    "reasons"
  ],
  "title": "UseGateDecision",
  "type": "object"
}
