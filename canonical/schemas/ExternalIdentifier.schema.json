{
  "$id": "https://keensight.local/v4.2/ExternalIdentifier.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "namespace": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "value": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "namespace",
    "value"
  ],
  "title": "ExternalIdentifier",
  "type": "object"
}
