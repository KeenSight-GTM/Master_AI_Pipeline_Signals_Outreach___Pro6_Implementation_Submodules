{
  "$id": "https://keensight.local/v4.2/IntakeRequest.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "idempotency_key": {
      "minLength": 1,
      "type": "string"
    },
    "intake_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "profile_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "KNOWLEDGE",
        "REVIEWED_HANDOFF"
      ]
    },
    "received_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "request_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "requester_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "targets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "resource_uri": {
            "format": "uri",
            "type": "string"
          },
          "subject_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "resource_uri",
          "subject_id"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    }
  },
  "required": [
    "intake_id",
    "tenant_id",
    "requester_id",
    "profile_id",
    "purpose",
    "targets",
    "received_at",
    "request_hash",
    "idempotency_key"
  ],
  "title": "IntakeRequest",
  "type": "object"
}
