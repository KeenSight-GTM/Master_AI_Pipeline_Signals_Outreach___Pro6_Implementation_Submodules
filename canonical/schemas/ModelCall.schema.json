{
  "$id": "https://keensight.local/v4.2/ModelCall.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "call_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "input_artifact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "max_repair_attempts": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "model": {
      "minLength": 1,
      "type": "string"
    },
    "output_schema_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "policy_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "prompt_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "type": "string"
    },
    "request_artifact_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "response_artifact_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "PARSED",
        "ABSTAINED",
        "FAILED"
      ]
    },
    "task_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "terminal_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "call_id",
    "tenant_id",
    "task_version",
    "provider",
    "model",
    "prompt_hash",
    "output_schema_id",
    "input_artifact_ids",
    "request_artifact_id",
    "response_artifact_id",
    "policy_ids",
    "max_repair_attempts",
    "status",
    "terminal_reason"
  ],
  "title": "ModelCall",
  "type": "object"
}
