{
  "$id": "https://keensight.local/v4.2/ScenarioEstimate.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "assumptions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "basis": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
            "type": "string"
          },
          "unit": {
            "minLength": 1,
            "type": "string"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "basis"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    },
    "formula_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "type": "string"
    },
    "implementation_status": {
      "const": "DESIGN_ONLY"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "lower_minor": {
      "minimum": 0,
      "type": "integer"
    },
    "observed_input_fact_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
        "type": "string"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "scenario_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "subject_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/\\-]*$",
      "type": "string"
    },
    "time_period": {
      "minLength": 1,
      "type": "string"
    },
    "upper_minor": {
      "minimum": 0,
      "type": "integer"
    },
    "verified_loss": {
      "const": false
    }
  },
  "required": [
    "scenario_id",
    "tenant_id",
    "subject_id",
    "observed_input_fact_ids",
    "assumptions",
    "formula_version",
    "currency",
    "lower_minor",
    "upper_minor",
    "time_period",
    "limitations",
    "verified_loss",
    "implementation_status"
  ],
  "title": "ScenarioEstimate",
  "type": "object"
}
