digraph G {
graph [rankdir=LR, nodesep=0.5, ranksep=1.2, splines=polyline, fontname="Helvetica", labelloc=t, label="Cross-partition domain relationships \u2014 selected fields only"];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
Subject [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Subject</B></TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR></TABLE>>];
PredicateDefinition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PredicateDefinition</B></TD></TR><TR><TD ALIGN="LEFT">+ string predicate_id</TD></TR></TABLE>>];
Fact [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Fact</B></TD></TR><TR><TD ALIGN="LEFT">+ string fact_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string predicate_id</TD></TR><TR><TD ALIGN="LEFT">+ Object target</TD></TR><TR><TD ALIGN="LEFT">+ string scope_id</TD></TR><TR><TD ALIGN="LEFT">+ enum state</TD></TR><TR><TD ALIGN="LEFT">+ enum nature</TD></TR><TR><TD ALIGN="LEFT">+ string source_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  binding_id</TD></TR><TR><TD ALIGN="LEFT">+ string evidence_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  execution_id</TD></TR><TR><TD ALIGN="LEFT">+ string run_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional Object  window</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  supersedes_fact_id</TD></TR></TABLE>>];
EvidenceSet [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>EvidenceSet</B></TD></TR><TR><TD ALIGN="LEFT">+ string evidence_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  execution_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  coverage_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  attempt_id</TD></TR></TABLE>>];
Artifact [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Artifact</B></TD></TR><TR><TD ALIGN="LEFT">+ string artifact_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string source_id</TD></TR><TR><TD ALIGN="LEFT">+ string scope_id</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR><TR><TD ALIGN="LEFT">+ string origin_record_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  parent_artifact_id</TD></TR></TABLE>>];
ExecutionRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ExecutionRecord</B></TD></TR><TR><TD ALIGN="LEFT">+ string execution_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string run_id</TD></TR><TR><TD ALIGN="LEFT">+ string function_id</TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  model_call_id</TD></TR></TABLE>>];
BatchRun [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BatchRun</B></TD></TR><TR><TD ALIGN="LEFT">+ string run_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string as_of</TD></TR><TR><TD ALIGN="LEFT">+ string profile_id</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR><TR><TD ALIGN="LEFT">+ string intake_id</TD></TR></TABLE>>];
ContextAssessment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ContextAssessment</B></TD></TR><TR><TD ALIGN="LEFT">+ string context_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string run_id</TD></TR><TR><TD ALIGN="LEFT">+ string account_subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string context_subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string join_rule_id</TD></TR><TR><TD ALIGN="LEFT">+ string link_fact_id</TD></TR><TR><TD ALIGN="LEFT">+ bool company_claim_allowed</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR></TABLE>>];
SignalEvaluation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SignalEvaluation</B></TD></TR><TR><TD ALIGN="LEFT">+ string signal_id</TD></TR><TR><TD ALIGN="LEFT">+ string run_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string signal_type_id</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR></TABLE>>];
OutreachPackage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>OutreachPackage</B></TD></TR><TR><TD ALIGN="LEFT">+ string package_id</TD></TR><TR><TD ALIGN="LEFT">+ string run_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string template_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  maturity_fact_id</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  review_id</TD></TR></TABLE>>];
GroundedClause [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>GroundedClause</B></TD></TR><TR><TD ALIGN="LEFT">+ string clause_id</TD></TR><TR><TD ALIGN="LEFT">+ string template_id</TD></TR></TABLE>>];
MetricDefinition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>MetricDefinition</B></TD></TR><TR><TD ALIGN="LEFT">+ string metric_id</TD></TR></TABLE>>];
Fact -> Subject [label="about", taillabel="*", headlabel="1"];
Fact -> PredicateDefinition [label="typed by", taillabel="*", headlabel="1"];
Fact -> EvidenceSet [label="supported by", taillabel="*", headlabel="1"];
EvidenceSet -> Artifact [label="through locators", taillabel="*", headlabel="0..*"];
EvidenceSet -> Fact [label="derived input refs", taillabel="*", headlabel="0..*"];
Fact -> ExecutionRecord [label="produced by", taillabel="*", headlabel="0..1"];
ExecutionRecord -> BatchRun [label="pinned run", taillabel="*", headlabel="1"];
ExecutionRecord -> Fact [label="reads and produces", taillabel="*", headlabel="*"];
Fact -> MetricDefinition [label="measurement contract", taillabel="*", headlabel="0..1"];
ContextAssessment -> Fact [label="account link and context fact", taillabel="*", headlabel="2..*"];
SignalEvaluation -> Fact [label="eligible inputs", taillabel="*", headlabel="0..*"];
SignalEvaluation -> ContextAssessment [label="internal context", taillabel="*", headlabel="0..*"];
OutreachPackage -> SignalEvaluation [label="based on", taillabel="*", headlabel="0..*"];
OutreachPackage -> GroundedClause [label="contains", dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*"];
GroundedClause -> Fact [label="own account claim support", taillabel="*", headlabel="1..*"];
}
