digraph G {
graph [rankdir=LR, nodesep=0.5, ranksep=1.2, splines=polyline, fontname="Helvetica", labelloc=t, label="Domain identity, facts and corrections"];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
Subject [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Subject</B></TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ enum kind</TD></TR><TR><TD ALIGN="LEFT">+ string display_name</TD></TR><TR><TD ALIGN="LEFT">+ List Object  external_ids</TD></TR></TABLE>>];
Scope [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Scope</B></TD></TR><TR><TD ALIGN="LEFT">+ string scope_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ enum kind</TD></TR><TR><TD ALIGN="LEFT">+ List string  resources</TD></TR><TR><TD ALIGN="LEFT">+ enum capture_mode</TD></TR><TR><TD ALIGN="LEFT">+ string population_description</TD></TR><TR><TD ALIGN="LEFT">+ string stable_scope_key</TD></TR></TABLE>>];
SubjectBinding [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SubjectBinding</B></TD></TR><TR><TD ALIGN="LEFT">+ string binding_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string scope_id</TD></TR><TR><TD ALIGN="LEFT">+ List string  artifact_ids</TD></TR><TR><TD ALIGN="LEFT">+ enum role</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR><TR><TD ALIGN="LEFT">+ string method</TD></TR><TR><TD ALIGN="LEFT">+ string decided_at</TD></TR><TR><TD ALIGN="LEFT">+ List string  evidence_locator_ids</TD></TR></TABLE>>];
PredicateDefinition [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PredicateDefinition</B></TD></TR><TR><TD ALIGN="LEFT">+ string predicate_id</TD></TR><TR><TD ALIGN="LEFT">+ string version</TD></TR><TR><TD ALIGN="LEFT">+ string family</TD></TR><TR><TD ALIGN="LEFT">+ string description</TD></TR><TR><TD ALIGN="LEFT">+ List enum  subject_kinds</TD></TR><TR><TD ALIGN="LEFT">+ Object target_schema</TD></TR><TR><TD ALIGN="LEFT">+ Object value_schema</TD></TR><TR><TD ALIGN="LEFT">+ List enum  allowed_natures</TD></TR><TR><TD ALIGN="LEFT">+ List enum  allowed_processors</TD></TR><TR><TD ALIGN="LEFT">+ bool absence_allowed</TD></TR><TR><TD ALIGN="LEFT">+ enum temporal_mode</TD></TR><TR><TD ALIGN="LEFT">+ enum copy_policy</TD></TR><TR><TD ALIGN="LEFT">+ List Object  reference_rules</TD></TR><TR><TD ALIGN="LEFT">+ List int  section_ids</TD></TR><TR><TD ALIGN="LEFT">+ string value_class</TD></TR><TR><TD ALIGN="LEFT">+ enum origin</TD></TR><TR><TD ALIGN="LEFT">+ Object example_target</TD></TR><TR><TD ALIGN="LEFT">+ PredicateValue example_value</TD></TR></TABLE>>];
Fact [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Fact</B></TD></TR><TR><TD ALIGN="LEFT">+ string schema_version</TD></TR><TR><TD ALIGN="LEFT">+ string fact_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string predicate_id</TD></TR><TR><TD ALIGN="LEFT">+ Object target</TD></TR><TR><TD ALIGN="LEFT">+ string scope_id</TD></TR><TR><TD ALIGN="LEFT">+ enum state</TD></TR><TR><TD ALIGN="LEFT">+ PredicateValue object</TD></TR><TR><TD ALIGN="LEFT">+ enum nature</TD></TR><TR><TD ALIGN="LEFT">+ string source_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  binding_id</TD></TR><TR><TD ALIGN="LEFT">+ string evidence_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  execution_id</TD></TR><TR><TD ALIGN="LEFT">+ string run_id</TD></TR><TR><TD ALIGN="LEFT">+ string observed_at</TD></TR><TR><TD ALIGN="LEFT">+ string recorded_at</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  effective_at</TD></TR><TR><TD ALIGN="LEFT">+ Optional Object  window</TD></TR><TR><TD ALIGN="LEFT">+ Optional enum  reason</TD></TR><TR><TD ALIGN="LEFT">+ string expires_at</TD></TR><TR><TD ALIGN="LEFT">+ Optional Object  confidence</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  supersedes_fact_id</TD></TR></TABLE>>];
ClaimResolution [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ClaimResolution</B></TD></TR><TR><TD ALIGN="LEFT">+ string resolution_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string subject_id</TD></TR><TR><TD ALIGN="LEFT">+ string predicate_id</TD></TR><TR><TD ALIGN="LEFT">+ string scope_id</TD></TR><TR><TD ALIGN="LEFT">+ Object target</TD></TR><TR><TD ALIGN="LEFT">+ List string  observation_ids</TD></TR><TR><TD ALIGN="LEFT">+ List string  accepted_fact_ids</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR><TR><TD ALIGN="LEFT">+ string policy_version</TD></TR><TR><TD ALIGN="LEFT">+ string as_of</TD></TR><TR><TD ALIGN="LEFT">+ string run_id</TD></TR><TR><TD ALIGN="LEFT">+ string resolved_at</TD></TR></TABLE>>];
CandidateRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>CandidateRecord</B></TD></TR><TR><TD ALIGN="LEFT">+ string candidate_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  artifact_id</TD></TR><TR><TD ALIGN="LEFT">+ string proposed_predicate_id</TD></TR><TR><TD ALIGN="LEFT">+ PredicateValue proposed_value</TD></TR><TR><TD ALIGN="LEFT">+ enum reason</TD></TR><TR><TD ALIGN="LEFT">+ bool production_eligible</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  attempt_id</TD></TR></TABLE>>];
ChangeRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ChangeRecord</B></TD></TR><TR><TD ALIGN="LEFT">+ string change_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ enum kind</TD></TR><TR><TD ALIGN="LEFT">+ string target_id</TD></TR><TR><TD ALIGN="LEFT">+ string effective_at</TD></TR><TR><TD ALIGN="LEFT">+ string reason</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  replacement_id</TD></TR></TABLE>>];
IntakeRequest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>IntakeRequest</B></TD></TR><TR><TD ALIGN="LEFT">+ string intake_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string requester_id</TD></TR><TR><TD ALIGN="LEFT">+ string profile_id</TD></TR><TR><TD ALIGN="LEFT">+ enum purpose</TD></TR><TR><TD ALIGN="LEFT">+ List Object  targets</TD></TR><TR><TD ALIGN="LEFT">+ string received_at</TD></TR><TR><TD ALIGN="LEFT">+ string request_hash</TD></TR><TR><TD ALIGN="LEFT">+ string idempotency_key</TD></TR></TABLE>>];
ActorGrant [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ActorGrant</B></TD></TR><TR><TD ALIGN="LEFT">+ string actor_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ List enum  permissions</TD></TR><TR><TD ALIGN="LEFT">+ bool fixture_only</TD></TR><TR><TD ALIGN="LEFT">+ bool active</TD></TR></TABLE>>];
Scope -> Subject [label="describes", taillabel="*", headlabel="1"];
SubjectBinding -> Subject [label="attributes", taillabel="*", headlabel="1"];
SubjectBinding -> Scope [label="binds", taillabel="*", headlabel="1"];
Fact -> Subject [label="concerns", taillabel="*", headlabel="1"];
Fact -> PredicateDefinition [label="conforms to", taillabel="*", headlabel="1"];
Fact -> Scope [label="scoped by", taillabel="*", headlabel="1"];
Fact -> SubjectBinding [label="raw attribution", taillabel="*", headlabel="0..1"];
ClaimResolution -> Fact [label="projects", dir=both, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="1..*"];
ChangeRecord -> Fact [label="can retract", style=dashed, taillabel="*", headlabel="0..1"];
CandidateRecord -> Fact [label="admit only after validation", style=dashed, taillabel="*", headlabel="0..1"];
}
