digraph G {
rankdir=TB; graph [fontname="Helvetica", labelloc=t, label="Evidence-to-reviewed-local-export lifecycle"];
node [shape=box, style=rounded, fontname="Helvetica", margin="0.2,0.15"]; edge [fontname="Helvetica", fontsize=10];
Start [label="Start"];
Intake [label="Intake"];
Attempt [label="Attempt"];
DiagnosticUnknown [label="DiagnosticUnknown"];
CapturedArtifact [label="CapturedArtifact"];
Candidate [label="Candidate"];
Quarantined [label="Quarantined"];
AdmittedFact [label="AdmittedFact"];
EligibleInput [label="EligibleInput"];
HistoricalOnly [label="HistoricalOnly"];
Unresolved [label="Unresolved"];
ResolvedSignal [label="ResolvedSignal"];
PreviewPackage [label="PreviewPackage"];
ReviewedRevision [label="ReviewedRevision"];
UseGate [label="UseGate"];
Blocked [label="Blocked"];
LocalExport [label="LocalExport"];
End [label="End"];
Start -> Intake;
Intake -> Attempt [label="approved profile and purpose"];
Attempt -> DiagnosticUnknown [label="failure without captured bytes"];
Attempt -> CapturedArtifact [label="permitted capture or import"];
CapturedArtifact -> Candidate [label="extract"];
Candidate -> Quarantined [label="invalid, failed producer or ambiguous binding"];
Candidate -> AdmittedFact [label="all admission checks pass"];
AdmittedFact -> EligibleInput [label="pinned lineage and claim resolution pass"];
AdmittedFact -> HistoricalOnly [label="expired, retracted or rights revoked"];
EligibleInput -> Unresolved [label="missing prerequisites or conflict"];
EligibleInput -> ResolvedSignal [label="enabled condition holds"];
ResolvedSignal -> PreviewPackage [label="supported deterministic template"];
PreviewPackage -> ReviewedRevision [label="authorized exact-hash review"];
ReviewedRevision -> UseGate [label="fresh checks for exact purpose and destination"];
UseGate -> Blocked [label="restrictions, stale evidence or changed inputs"];
UseGate -> LocalExport [label="ALLOW and idempotent file write"];
LocalExport -> End [label="no sending"];
DiagnosticUnknown -> End [label="retained diagnostic"];
Quarantined -> Candidate [label="explicit corrected extraction"];
}
