digraph G {
graph [rankdir=LR, nodesep=0.5, ranksep=1.2, splines=polyline, fontname="Helvetica", labelloc=t, label="Proposed application interfaces, not deployed services"];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
BatchRunner [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BatchRunner</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ RegistryLinker registry</TD></TR><TR><TD ALIGN="LEFT">+ FactRepository facts</TD></TR><TR><TD ALIGN="LEFT">+ run(intake_id) BatchRun</TD></TR></TABLE>>];
RegistryLinker [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RegistryLinker</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ load_release(release_id) void</TD></TR><TR><TD ALIGN="LEFT">+ validate_closure(profile) void</TD></TR><TR><TD ALIGN="LEFT">+ execution_order(profile) List FunctionDefinition </TD></TR></TABLE>>];
SourceAdapter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SourceAdapter</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ capture(target, scope) AcquisitionAttempt</TD></TR></TABLE>>];
AcquisitionService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AcquisitionService</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ SourceAdapter adapter</TD></TR><TR><TD ALIGN="LEFT">+ RightsGate rights</TD></TR><TR><TD ALIGN="LEFT">+ ContentRepository content</TD></TR><TR><TD ALIGN="LEFT">+ collect(intake, scope) AcquisitionAttempt</TD></TR></TABLE>>];
RightsGate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RightsGate</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ assert_use(policy_ids, purpose, as_of) void</TD></TR><TR><TD ALIGN="LEFT">+ retention_deadline(policy_ids) datetime</TD></TR></TABLE>>];
ContentRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ContentRepository</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ put_immutable(bytes, policy) Artifact</TD></TR><TR><TD ALIGN="LEFT">+ read_verified(artifact_id) bytes</TD></TR><TR><TD ALIGN="LEFT">+ delete(artifact_id) ChangeRecord</TD></TR></TABLE>>];
SubjectResolver [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SubjectResolver</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ bind(artifact, subject, locators) SubjectBinding</TD></TR></TABLE>>];
ExtractionService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ExtractionService</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ BoundedModelGateway model</TD></TR><TR><TD ALIGN="LEFT">+ extract(artifact, definition) List CandidateRecord </TD></TR></TABLE>>];
BoundedModelGateway [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>BoundedModelGateway</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ call(task, artifacts) ModelCall</TD></TR><TR><TD ALIGN="LEFT">+ repair_or_abstain(call) QuotedTextResult</TD></TR></TABLE>>];
FactAdmission [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>FactAdmission</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ RightsGate rights</TD></TR><TR><TD ALIGN="LEFT">+ RegistryLinker registry</TD></TR><TR><TD ALIGN="LEFT">+ validate(candidate, evidence, binding) Fact</TD></TR><TR><TD ALIGN="LEFT">+ quarantine(candidate, reason) CandidateRecord</TD></TR></TABLE>>];
FactRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>FactRepository</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ append_idempotent(fact) Fact</TD></TR><TR><TD ALIGN="LEFT">+ select_inputs(subject, as_of) List Fact </TD></TR><TR><TD ALIGN="LEFT">+ record_change(change) void</TD></TR></TABLE>>];
AccountInputSelector [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AccountInputSelector</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ FactRepository facts</TD></TR><TR><TD ALIGN="LEFT">+ freeze_account_inputs(subject, as_of) BatchRun</TD></TR></TABLE>>];
DerivationRunner [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>DerivationRunner</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ evaluate(function, inputs, parameters) ExecutionRecord</TD></TR></TABLE>>];
ContextJoiner [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ContextJoiner</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ join(rule, account_facts, context_facts) ContextAssessment</TD></TR></TABLE>>];
SignalEngine [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SignalEngine</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ evaluate(definition, facts, contexts) SignalEvaluation</TD></TR></TABLE>>];
TemplateRenderer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>TemplateRenderer</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ render(template, eligible_facts) List GroundedClause </TD></TR></TABLE>>];
PackageValidator [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PackageValidator</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ RightsGate rights</TD></TR><TR><TD ALIGN="LEFT">+ approve_preview(package, as_of) OutreachPackage</TD></TR><TR><TD ALIGN="LEFT">+ revalidate_for_export(package, as_of) void</TD></TR></TABLE>>];
RetentionService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RetentionService</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ ContentRepository content</TD></TR><TR><TD ALIGN="LEFT">+ FactRepository facts</TD></TR><TR><TD ALIGN="LEFT">+ apply_policy(policy, as_of) List ChangeRecord </TD></TR></TABLE>>];
UnitOfWork [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>UnitOfWork</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ begin() void</TD></TR><TR><TD ALIGN="LEFT">+ commit_account_result() void</TD></TR><TR><TD ALIGN="LEFT">+ rollback() void</TD></TR></TABLE>>];
ReviewService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>ReviewService</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ review(exact_package_revision, principal) ReviewDecision</TD></TR></TABLE>>];
UseGate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>UseGate</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ evaluate(package, destination, principal, current_time) UseGateDecision</TD></TR></TABLE>>];
LocalPreviewExporter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>LocalPreviewExporter</B></TD></TR><TR><TD><I>proposed interface</I></TD></TR><TR><TD ALIGN="LEFT">+ export(gate_id, principal_id, at, idempotency_key) LocalExportResult</TD></TR></TABLE>>];
BatchRunner -> ReviewService [label="review exact revision", style=dashed];
BatchRunner -> UseGate [label="current permission", style=dashed];
UseGate -> LocalPreviewExporter [label="allow local export only", style=dashed];
BatchRunner -> RegistryLinker [label="uses", style=dashed];
BatchRunner -> AcquisitionService [label="optional capture", style=dashed];
BatchRunner -> AccountInputSelector [label="pins inputs", style=dashed];
BatchRunner -> DerivationRunner [label="sequential plan", style=dashed];
BatchRunner -> ContextJoiner [label="context join", style=dashed];
BatchRunner -> SignalEngine [label="evaluate", style=dashed];
BatchRunner -> TemplateRenderer [label="compose", style=dashed];
BatchRunner -> PackageValidator [label="approve preview", style=dashed];
BatchRunner -> UnitOfWork [label="publish atomically per account", style=dashed];
AcquisitionService -> SourceAdapter [label="port", style=dashed];
AcquisitionService -> ContentRepository [label="persist", style=dashed];
AcquisitionService -> RightsGate [label="before capture", style=dashed];
ExtractionService -> SubjectResolver [label="attribution", style=dashed];
ExtractionService -> BoundedModelGateway [label="optional", style=dashed];
ExtractionService -> FactAdmission [label="no direct promotion", style=dashed];
FactAdmission -> FactRepository [label="append", style=dashed];
FactAdmission -> RightsGate [label="permitted derivation", style=dashed];
AccountInputSelector -> FactRepository [label="select", style=dashed];
PackageValidator -> RightsGate [label="current use check", style=dashed];
RetentionService -> ContentRepository [label="delete or expire", style=dashed];
RetentionService -> FactRepository [label="record changes", style=dashed];
}
