digraph G {
graph [rankdir=LR, nodesep=0.5, ranksep=1.2, splines=polyline, fontname="Helvetica", labelloc=t, label="Registry, authorized call and future outcome payloads"];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
RegistryRecordValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>RegistryRecordValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string namespace</TD></TR><TR><TD ALIGN="LEFT">+ string record_id</TD></TR><TR><TD ALIGN="LEFT">+ string issuer</TD></TR><TR><TD ALIGN="LEFT">+ string jurisdiction</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  effective_at</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  filed_at</TD></TR><TR><TD ALIGN="LEFT">+ string record_status</TD></TR></TABLE>>];
CallEventValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>CallEventValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string call_key</TD></TR><TR><TD ALIGN="LEFT">+ string started_at</TD></TR><TR><TD ALIGN="LEFT">+ enum direction</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR><TR><TD ALIGN="LEFT">+ Optional number  duration_seconds</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  callback_of</TD></TR></TABLE>>];
EconomicHypothesisValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>EconomicHypothesisValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string currency</TD></TR><TR><TD ALIGN="LEFT">+ int estimated_amount_minor</TD></TR><TR><TD ALIGN="LEFT">+ List string  assumptions</TD></TR><TR><TD ALIGN="LEFT">+ List string  limitations</TD></TR></TABLE>>];
Exposure [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>Exposure</B></TD></TR><TR><TD ALIGN="LEFT">+ string exposure_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string package_id</TD></TR><TR><TD ALIGN="LEFT">+ string business_send_key</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  provider_message_id</TD></TR><TR><TD ALIGN="LEFT">+ string recipient_key</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  accepted_at</TD></TR><TR><TD ALIGN="LEFT">+ enum status</TD></TR></TABLE>>];
OutcomeEvent [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>OutcomeEvent</B></TD></TR><TR><TD ALIGN="LEFT">+ string event_id</TD></TR><TR><TD ALIGN="LEFT">+ string tenant_id</TD></TR><TR><TD ALIGN="LEFT">+ string provider</TD></TR><TR><TD ALIGN="LEFT">+ string provider_event_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  exposure_id</TD></TR><TR><TD ALIGN="LEFT">+ string occurred_at</TD></TR><TR><TD ALIGN="LEFT">+ string received_at</TD></TR><TR><TD ALIGN="LEFT">+ enum kind</TD></TR><TR><TD ALIGN="LEFT">+ enum attribution_status</TD></TR><TR><TD ALIGN="LEFT">+ string evidence_id</TD></TR></TABLE>>];
CallEventValue -> EconomicHypothesisValue [label="inputs plus explicit assumptions", style=dashed, taillabel="*", headlabel="0..*"];
OutcomeEvent -> Exposure [label="matched or quarantined", taillabel="*", headlabel="0..1"];
}
