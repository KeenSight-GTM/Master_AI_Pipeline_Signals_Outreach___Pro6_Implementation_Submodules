digraph G {
graph [rankdir=LR, nodesep=0.5, ranksep=1.2, splines=polyline, fontname="Helvetica", labelloc=t, label="Typed payload examples: tooling, hiring and workflow"];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, arrowsize=0.7];
TechnologyValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>TechnologyValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string product_id</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  version</TD></TR><TR><TD ALIGN="LEFT">+ enum surface</TD></TR><TR><TD ALIGN="LEFT">+ string matched_value</TD></TR><TR><TD ALIGN="LEFT">+ string fingerprint_id</TD></TR><TR><TD ALIGN="LEFT">+ string deployment_claim</TD></TR></TABLE>>];
TechnologyReportValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>TechnologyReportValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string product_id</TD></TR><TR><TD ALIGN="LEFT">+ string provider</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  provider_detected_at</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  reported_version</TD></TR></TABLE>>];
JobPostingValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>JobPostingValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string posting_id</TD></TR><TR><TD ALIGN="LEFT">+ string namespace</TD></TR><TR><TD ALIGN="LEFT">+ string url</TD></TR><TR><TD ALIGN="LEFT">+ string title</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  department</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  published_at</TD></TR><TR><TD ALIGN="LEFT">+ Optional enum  employment_type</TD></TR></TABLE>>];
SalaryValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SalaryValue</B></TD></TR><TR><TD ALIGN="LEFT">+ Optional int  minimum_minor</TD></TR><TR><TD ALIGN="LEFT">+ Optional int  maximum_minor</TD></TR><TR><TD ALIGN="LEFT">+ string currency</TD></TR><TR><TD ALIGN="LEFT">+ int minor_unit_exponent</TD></TR><TR><TD ALIGN="LEFT">+ enum period</TD></TR><TR><TD ALIGN="LEFT">+ enum basis</TD></TR></TABLE>>];
AttributedStatementValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>AttributedStatementValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string statement_id</TD></TR><TR><TD ALIGN="LEFT">+ string text</TD></TR><TR><TD ALIGN="LEFT">+ string topic_id</TD></TR><TR><TD ALIGN="LEFT">+ enum modality</TD></TR></TABLE>>];
SurfaceObservationValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>SurfaceObservationValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string surface_key</TD></TR><TR><TD ALIGN="LEFT">+ string observed_value</TD></TR></TABLE>>];
HypothesisValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>HypothesisValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string hypothesis_id</TD></TR><TR><TD ALIGN="LEFT">+ string conclusion</TD></TR><TR><TD ALIGN="LEFT">+ List string  alternatives</TD></TR><TR><TD ALIGN="LEFT">+ List string  limitations</TD></TR><TR><TD ALIGN="LEFT">+ string verification_question</TD></TR></TABLE>>];
QuotedTextResult [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>QuotedTextResult</B></TD></TR><TR><TD ALIGN="LEFT">+ string text</TD></TR></TABLE>>];
PublishedRecordValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>PublishedRecordValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string namespace</TD></TR><TR><TD ALIGN="LEFT">+ string record_id</TD></TR><TR><TD ALIGN="LEFT">+ string url</TD></TR><TR><TD ALIGN="LEFT">+ string publisher</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  published_at</TD></TR><TR><TD ALIGN="LEFT">+ string record_type</TD></TR><TR><TD ALIGN="LEFT">+ string title</TD></TR><TR><TD ALIGN="LEFT">+ string text</TD></TR></TABLE>>];
CaseStudyOutcomeValue [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD><B>CaseStudyOutcomeValue</B></TD></TR><TR><TD ALIGN="LEFT">+ string case_id</TD></TR><TR><TD ALIGN="LEFT">+ string outcome_id</TD></TR><TR><TD ALIGN="LEFT">+ string publisher</TD></TR><TR><TD ALIGN="LEFT">+ string source_url</TD></TR><TR><TD ALIGN="LEFT">+ string reported_quote</TD></TR><TR><TD ALIGN="LEFT">+ string metric_name</TD></TR><TR><TD ALIGN="LEFT">+ number reported_value</TD></TR><TR><TD ALIGN="LEFT">+ string unit</TD></TR><TR><TD ALIGN="LEFT">+ Optional number  baseline_value</TD></TR><TR><TD ALIGN="LEFT">+ enum comparison_kind</TD></TR><TR><TD ALIGN="LEFT">+ Optional Object  measurement_window</TD></TR><TR><TD ALIGN="LEFT">+ Optional int  sample_size</TD></TR><TR><TD ALIGN="LEFT">+ Optional string  method_description</TD></TR><TR><TD ALIGN="LEFT">+ string attribution</TD></TR><TR><TD ALIGN="LEFT">+ bool transfer_to_target_allowed</TD></TR></TABLE>>];
JobPostingValue -> SalaryValue [label="separate fact by posting key", style=dashed, taillabel="1", headlabel="0..*"];
JobPostingValue -> AttributedStatementValue [label="may support extracted statements", style=dashed, taillabel="1", headlabel="0..*"];
QuotedTextResult -> AttributedStatementValue [label="requires quote and binding checks", style=dashed, taillabel="1", headlabel="0..1"];
AttributedStatementValue -> HypothesisValue [label="inputs not proof of conclusion", style=dashed, taillabel="*", headlabel="0..*"];
SurfaceObservationValue -> TechnologyValue [label="detector evidence", style=dashed, taillabel="*", headlabel="0..*"];
TechnologyReportValue -> TechnologyValue [label="distinct epistemic channels", style=dashed, taillabel="*", headlabel="*"];
}
