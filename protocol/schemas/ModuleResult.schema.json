{
  "$id": "urn:keensight:module-protocol:1.0.0-draft.1:ModuleResult",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "FAILED",
              "SKIPPED",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "diagnostics": {
            "minItems": 1
          },
          "output_refs": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "properties": {
    "consumed_refs": {
      "items": {
        "$ref": "urn:keensight:module-protocol:1.0.0-draft.1:Common#/definitions/RecordRef"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "context": {
      "$ref": "urn:keensight:module-protocol:1.0.0-draft.1:Common#/definitions/Context"
    },
    "diagnostic_record_refs": {
      "items": {
        "$ref": "urn:keensight:module-protocol:1.0.0-draft.1:Common#/definitions/RecordRef"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "diagnostics": {
      "items": {
        "$ref": "urn:keensight:module-protocol:1.0.0-draft.1:Diagnostic"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "execution_id": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
    },
    "execution_status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "SKIPPED",
        "CANCELLED"
      ]
    },
    "finished_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "module_id": {
      "pattern": "^[A-Z]{2,5}-[0-9]{2}$",
      "type": "string"
    },
    "operation": {
      "pattern": "^[a-z][a-z0-9_.]*$",
      "type": "string"
    },
    "output_refs": {
      "items": {
        "$ref": "urn:keensight:module-protocol:1.0.0-draft.1:Common#/definitions/RecordRef"
      },
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "protocol_version": {
      "const": "1.0.0-draft.1"
    },
    "request_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "request_id": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
    },
    "reused_execution_id": {
      "anyOf": [
        {
          "maxLength": 240,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "trace": {
      "$ref": "urn:keensight:module-protocol:1.0.0-draft.1:Common#/definitions/Trace"
    },
    "usage": {
      "$ref": "urn:keensight:module-protocol:1.0.0-draft.1:Common#/definitions/ResourceUsage"
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "request_digest",
    "execution_id",
    "module_id",
    "operation",
    "context",
    "trace",
    "execution_status",
    "started_at",
    "finished_at",
    "consumed_refs",
    "output_refs",
    "diagnostic_record_refs",
    "diagnostics",
    "usage",
    "reused_execution_id"
  ],
  "type": "object"
}
